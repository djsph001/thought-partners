---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  date: Date;
  description: string;
  author: string;
}

const { title, date, description, author } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={`${title} — Thought Partners`} description={description}>
  <Header slot="header" />
  <article class="section">
    <div class="container">
      <header class="post-header">
        <p class="post-meta muted">
          <time datetime={date.toISOString()}>{formattedDate}</time>
          {author && <span> · {author}</span>}
        </p>
        <h1>{title}</h1>
        <p class="post-description">{description}</p>
        <div class="divider"></div>
      </header>
      <div class="prose">
        <slot />
      </div>
      <footer class="post-footer">
        <div class="divider"></div>
        <a href="/blog" class="btn">← Back to Essays</a>
      </footer>
    </div>
  </article>
  <Footer slot="footer" />
</Base>

<style>
  .post-header {
    margin-bottom: 2.5rem;
  }

  .post-meta {
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    margin-bottom: 1rem;
    font-family: Georgia, serif;
  }

  .post-header h1 {
    margin-bottom: 1rem;
  }

  .post-description {
    color: var(--text-muted);
    font-size: 1.05rem;
    font-style: italic;
    margin-bottom: 0;
  }

  .prose :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .prose :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--gold);
    padding: 0.75rem 1.25rem;
    margin: 1.5rem 0;
    background: var(--bg-card);
    color: var(--text-muted);
    font-style: italic;
  }

  .prose :global(hr) {
    margin: 2.5rem 0;
  }

  .prose :global(strong) {
    color: var(--gold-light);
  }

  .post-footer {
    margin-top: 3rem;
  }
</style>
