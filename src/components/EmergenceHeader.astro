---
const pathname = Astro.url.pathname;
const isActive = (path: string) =>
  pathname === path || (path !== '/emergence' && pathname.startsWith(path));
---

<header class="site-header ec-header">
  <div class="container--wide header-inner">
    <a href="/emergence" class="wordmark">
      <span class="wordmark-title">The Emergence Institute</span>
      <span class="wordmark-sub">by Dale Joseph</span>
    </a>
    <button class="nav-toggle" aria-label="Toggle navigation" id="nav-toggle">
      <span></span><span></span><span></span>
    </button>
    <nav class="nav" id="main-nav">
      <a href="/emergence/collective" class:list={['nav-link nav-link--hide-sm', { active: isActive('/emergence/collective') }]}>The Collective</a>
      <a href="/emergence/gardeners-handbook" class:list={['nav-link', { active: isActive('/emergence/gardeners-handbook') }]}>Handbook</a>
      <a href="/emergence/haiti-pilot" class:list={['nav-link', { active: isActive('/emergence/haiti-pilot') }]}>Haiti Pilot</a>
      <a href="/emergence/protocols" class:list={['nav-link', { active: isActive('/emergence/protocols') }]}>Protocols</a>
      <a href="/emergence/book" class:list={['nav-link', { active: isActive('/emergence/book') }]}>The Book</a>
      <a href="/emergence/engine-room" class:list={['nav-link nav-link--hide-sm', { active: isActive('/emergence/engine-room') }]}>Engine Room</a>
      <a href="/emergence/mycelium" class:list={['nav-link nav-link--hide-sm', { active: isActive('/emergence/mycelium') }]}>Mycelium</a>
      <a href="/emergence/manifesto" class:list={['nav-link nav-link--hide-sm', { active: isActive('/emergence/manifesto') }]}>Manifesto</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('main-nav');
  toggle?.addEventListener('click', () => {
    nav?.classList.toggle('nav--open');
    toggle.classList.toggle('nav-toggle--open');
  });
  nav?.querySelectorAll('.nav-link').forEach(link => {
    link.addEventListener('click', () => {
      nav.classList.remove('nav--open');
      toggle?.classList.remove('nav-toggle--open');
    });
  });
</script>

<style>
  .ec-header {
    border-bottom: 1px solid var(--border);
    padding: 1.25rem 0;
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    position: relative;
  }

  .wordmark {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .wordmark:hover { text-decoration: none; }

  .wordmark-title {
    font-family: Georgia, serif;
    font-size: 1.05rem;
    color: var(--gold);
    letter-spacing: 0.01em;
    line-height: 1;
  }

  .wordmark-sub {
    font-family: Georgia, serif;
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    line-height: 1;
  }

  .nav {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .nav-link {
    font-family: Georgia, serif;
    font-size: 0.9rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--gold);
    text-decoration: none;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    z-index: 101;
  }

  .nav-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text-muted);
    transition: all 0.2s ease;
  }

  .nav-toggle--open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle--open span:nth-child(2) { opacity: 0; }
  .nav-toggle--open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 760px) {
    .nav-toggle { display: flex; }

    .nav {
      display: none;
      position: absolute;
      top: calc(100% + 1.25rem);
      right: 0;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      min-width: 200px;
      padding: 0.5rem 0;
    }

    .nav--open { display: flex; }

    .nav-link {
      width: 100%;
      padding: 0.75rem 1.5rem;
      font-size: 0.95rem;
    }

    .nav-link--hide-sm { display: flex; }
  }

  @media (max-width: 900px) {
    .nav-link--hide-sm { display: none; }
  }

  @media (max-width: 420px) {
    .wordmark-sub { display: none; }
  }
</style>
