---
// LakouRadiusDiagram.astro
// Diagram 2: The Lakou Radius
// Concentric rings of witness nodes around a central Spore record
---

<div class="lakou-viz" id="lakou-viz">
  <p class="lakou-viz__label">Diagram 2: The Lakou Radius</p>
  <canvas id="lakou-canvas"></canvas>
  <div class="lakou-viz__legend">
    <p class="lakou-viz__legend-title">Witness States</p>
    <div class="lakou-viz__legend-row"><span class="lakou-viz__dot" style="background:#f0a030;box-shadow:0 0 6px #f0a030"></span> Active Witness (recent handshake)</div>
    <div class="lakou-viz__legend-row"><span class="lakou-viz__dot" style="background:rgba(245,230,200,0.25);box-shadow:none"></span> Inactive (&gt;30 days)</div>
    <div class="lakou-viz__legend-row"><span class="lakou-viz__dot" style="background:#4de8d0;box-shadow:0 0 6px #4de8d0"></span> Central Spore Record</div>
    <div class="lakou-viz__legend-row"><span class="lakou-viz__dot lakou-viz__dot--line" style="background:none;border:1px dashed #c9a227"></span> 80% Threshold</div>
  </div>
</div>

<style>
  .lakou-viz {
    position: relative;
    margin-top: 2rem;
    background: #0a0a12;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 4px;
    overflow: hidden;
  }

  .lakou-viz__label {
    position: absolute;
    top: 12px;
    left: 16px;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold, #c9a227);
    z-index: 2;
    margin: 0;
    pointer-events: none;
  }

  #lakou-canvas {
    display: block;
    width: 100%;
    height: 450px;
  }

  .lakou-viz__legend {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background: rgba(10, 10, 18, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 8px;
    padding: 12px 16px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 11px;
    line-height: 1.85;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    pointer-events: none;
    user-select: none;
    z-index: 2;
  }

  .lakou-viz__legend-title {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 1.8px;
    color: rgba(255, 255, 255, 0.34);
    margin: 0 0 6px 0;
  }

  .lakou-viz__legend-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .lakou-viz__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .lakou-viz__dot--line {
    border-radius: 2px;
    width: 14px;
    height: 0;
    border-top: 1px dashed #c9a227;
  }

  @media (max-width: 640px) {
    #lakou-canvas { height: 360px; }
    .lakou-viz__legend { font-size: 9px; padding: 8px 10px; bottom: 8px; right: 8px; }
  }
</style>

<script>
  (function () {
    const container = document.getElementById('lakou-viz');
    const cvs = document.getElementById('lakou-canvas') as HTMLCanvasElement;
    if (!container || !cvs) return;
    const ctx = cvs.getContext('2d');
    if (!ctx) return;

    const BG = '#0a0a12';
    const GOLD = { r: 240, g: 160, b: 48 };
    const TEAL = { r: 77, g: 232, b: 208 };
    const FADED = { r: 245, g: 230, b: 200 };
    const isMobile = window.innerWidth < 640;

    let W: number, H: number;
    function resize() {
      const rect = cvs.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = rect.width;
      H = rect.height;
      cvs.width = W * dpr;
      cvs.height = H * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resize();
    window.addEventListener('resize', resize);

    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    const rgba = (r: number, g: number, b: number, a: number) => `rgba(${r|0},${g|0},${b|0},${a})`;

    interface WitnessNode {
      ring: number;
      angle: number;
      angleSpeed: number;
      active: boolean;
      phase: number;
      pSpeed: number;
      sigProgress: number;
      sigActive: boolean;
      sigDelay: number;
    }

    const RING_COUNT = 3;
    const NODES_PER_RING = isMobile ? [5, 8, 12] : [6, 10, 16];
    const RING_RADII = isMobile ? [55, 100, 145] : [70, 130, 190];
    const THRESHOLD_RING = 1;

    const witnesses: WitnessNode[] = [];
    for (let r = 0; r < RING_COUNT; r++) {
      for (let i = 0; i < NODES_PER_RING[r]; i++) {
        const baseAngle = (Math.PI * 2 / NODES_PER_RING[r]) * i + rand(-0.15, 0.15);
        const inactiveChance = r === 0 ? 0.1 : r === 1 ? 0.2 : 0.4;
        witnesses.push({
          ring: r,
          angle: baseAngle,
          angleSpeed: rand(0.0003, 0.0008) * (Math.random() < 0.5 ? 1 : -1),
          active: Math.random() > inactiveChance,
          phase: rand(0, Math.PI * 2),
          pSpeed: rand(0.01, 0.025),
          sigProgress: 0,
          sigActive: false,
          sigDelay: rand(500, 6000),
        });
      }
    }

    let lastSigTime = 0;
    let running = false;
    let animId: number;
    let lastFrame = 0;

    function frame(now: number) {
      if (!running) return;
      animId = requestAnimationFrame(frame);
      const dt = lastFrame ? Math.min(now - lastFrame, 50) : 16.67;
      lastFrame = now;

      ctx!.fillStyle = BG;
      ctx!.fillRect(0, 0, W, H);

      const vg = ctx!.createRadialGradient(W / 2, H / 2, W * 0.05, W / 2, H / 2, W * 0.55);
      vg.addColorStop(0, 'rgba(14,13,26,0)');
      vg.addColorStop(1, 'rgba(3,3,7,0.55)');
      ctx!.fillStyle = vg;
      ctx!.fillRect(0, 0, W, H);

      const cx = W / 2;
      const cy = H / 2;

      // Draw concentric ring guides
      for (let r = 0; r < RING_COUNT; r++) {
        ctx!.beginPath();
        ctx!.arc(cx, cy, RING_RADII[r], 0, Math.PI * 2);
        ctx!.strokeStyle = rgba(255, 255, 255, 0.04);
        ctx!.lineWidth = 1;
        ctx!.stroke();
      }

      // Draw 80% threshold line
      const threshRadius = (RING_RADII[THRESHOLD_RING] + RING_RADII[THRESHOLD_RING + 1]) / 2;
      ctx!.beginPath();
      ctx!.arc(cx, cy, threshRadius, 0, Math.PI * 2);
      ctx!.strokeStyle = rgba(201, 162, 39, 0.35);
      ctx!.lineWidth = 1;
      ctx!.setLineDash([6, 4]);
      ctx!.stroke();
      ctx!.setLineDash([]);

      // Label the threshold
      ctx!.save();
      ctx!.font = '9px system-ui, sans-serif';
      ctx!.fillStyle = rgba(201, 162, 39, 0.5);
      ctx!.textAlign = 'left';
      ctx!.fillText('80% THRESHOLD', cx + threshRadius * Math.cos(-0.3) + 6, cy + threshRadius * Math.sin(-0.3));
      ctx!.restore();

      // Central Spore record
      const sporeGlow = 0.7 + Math.sin(now * 0.003) * 0.3;
      const sporeGrad = ctx!.createRadialGradient(cx, cy, 2, cx, cy, 28);
      sporeGrad.addColorStop(0, rgba(TEAL.r, TEAL.g, TEAL.b, 0.6 * sporeGlow));
      sporeGrad.addColorStop(0.5, rgba(TEAL.r, TEAL.g, TEAL.b, 0.12 * sporeGlow));
      sporeGrad.addColorStop(1, rgba(TEAL.r, TEAL.g, TEAL.b, 0));
      ctx!.fillStyle = sporeGrad;
      ctx!.beginPath();
      ctx!.arc(cx, cy, 28, 0, Math.PI * 2);
      ctx!.fill();

      ctx!.fillStyle = rgba(TEAL.r, TEAL.g, TEAL.b, 0.9 * sporeGlow);
      ctx!.shadowColor = rgba(TEAL.r, TEAL.g, TEAL.b, 0.6);
      ctx!.shadowBlur = 12;
      ctx!.beginPath();
      ctx!.arc(cx, cy, 5, 0, Math.PI * 2);
      ctx!.fill();
      ctx!.shadowBlur = 0;

      // Spore label
      ctx!.save();
      ctx!.font = '8px system-ui, sans-serif';
      ctx!.fillStyle = rgba(TEAL.r, TEAL.g, TEAL.b, 0.6);
      ctx!.textAlign = 'center';
      ctx!.fillText('SPORE', cx, cy + 18);
      ctx!.restore();

      // Trigger witness signatures periodically
      if (now - lastSigTime > 2200) {
        lastSigTime = now;
        const active = witnesses.filter(w => w.active && !w.sigActive);
        if (active.length > 0) {
          const count = Math.min(Math.ceil(active.length * 0.3), 5);
          for (let i = 0; i < count; i++) {
            const idx = Math.floor(Math.random() * active.length);
            active[idx].sigActive = true;
            active[idx].sigProgress = 0;
            active.splice(idx, 1);
          }
        }
      }

      // Update and draw witness nodes
      for (const w of witnesses) {
        w.angle += w.angleSpeed * dt;
        w.phase += w.pSpeed * dt;

        const nx = cx + Math.cos(w.angle) * RING_RADII[w.ring];
        const ny = cy + Math.sin(w.angle) * RING_RADII[w.ring];

        const pulse = 0.7 + Math.sin(w.phase) * 0.3;

        if (w.active) {
          // Draw signature arrow if active
          if (w.sigActive) {
            w.sigProgress += dt * 0.0012;
            if (w.sigProgress >= 1) {
              w.sigActive = false;
              w.sigProgress = 0;
            } else {
              const progress = w.sigProgress;
              const arrowX = nx + (cx - nx) * progress;
              const arrowY = ny + (cy - ny) * progress;
              const arrowAlpha = progress < 0.2 ? progress * 5 : progress > 0.8 ? (1 - progress) * 5 : 1;

              ctx!.beginPath();
              ctx!.moveTo(nx, ny);
              ctx!.lineTo(arrowX, arrowY);
              ctx!.strokeStyle = rgba(GOLD.r, GOLD.g, GOLD.b, 0.3 * arrowAlpha);
              ctx!.lineWidth = 1;
              ctx!.stroke();

              // Arrow head particle
              ctx!.fillStyle = rgba(GOLD.r, GOLD.g, GOLD.b, 0.8 * arrowAlpha);
              ctx!.shadowColor = rgba(GOLD.r, GOLD.g, GOLD.b, 0.5);
              ctx!.shadowBlur = 6;
              ctx!.beginPath();
              ctx!.arc(arrowX, arrowY, 2, 0, Math.PI * 2);
              ctx!.fill();
              ctx!.shadowBlur = 0;
            }
          }

          // Active node glow
          const nodeGrad = ctx!.createRadialGradient(nx, ny, 1, nx, ny, 16);
          nodeGrad.addColorStop(0, rgba(GOLD.r, GOLD.g, GOLD.b, 0.4 * pulse));
          nodeGrad.addColorStop(0.5, rgba(GOLD.r, GOLD.g, GOLD.b, 0.08 * pulse));
          nodeGrad.addColorStop(1, rgba(GOLD.r, GOLD.g, GOLD.b, 0));
          ctx!.fillStyle = nodeGrad;
          ctx!.beginPath();
          ctx!.arc(nx, ny, 16, 0, Math.PI * 2);
          ctx!.fill();

          ctx!.fillStyle = rgba(GOLD.r, GOLD.g, GOLD.b, 0.85 * pulse);
          ctx!.shadowColor = rgba(GOLD.r, GOLD.g, GOLD.b, 0.5);
          ctx!.shadowBlur = 8;
          ctx!.beginPath();
          ctx!.arc(nx, ny, 3.2, 0, Math.PI * 2);
          ctx!.fill();
          ctx!.shadowBlur = 0;
        } else {
          // Inactive / faded node
          ctx!.fillStyle = rgba(FADED.r, FADED.g, FADED.b, 0.15 * pulse);
          ctx!.beginPath();
          ctx!.arc(nx, ny, 2.5, 0, Math.PI * 2);
          ctx!.fill();
        }
      }
    }

    function start() {
      if (running) return;
      running = true;
      lastFrame = 0;
      animId = requestAnimationFrame(frame);
    }

    function stop() {
      running = false;
      cancelAnimationFrame(animId);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          entry.isIntersecting ? start() : stop();
        }
      },
      { threshold: 0.1 },
    );
    observer.observe(container);
  })();
</script>
