---
import Footer from './Footer.astro';
---

<!-- Institute pages: global footer + one muted Institute row.
     Import name preserved so existing pages need no edits. -->
<Footer>
  <div class="container--wide footer-extra institute-row">
    <span class="institute-row-label">The Emergence Institute:</span>
    <a href="/emergence/collective">Collective</a>
    <a href="/emergence/charter">Charter</a>
    <a href="/emergence/community">Community</a>
    <a href="/emergence/gallery">Gallery</a>
    <a href="/emergence/engine-room">Engine Room</a>
    <a href="/emergence/updates">Updates</a>
  </div>
</Footer>

<style>
  .institute-row {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .institute-row-label {
    font-size: 0.8rem;
    color: var(--gold);
    letter-spacing: 0.05em;
    font-style: italic;
  }

  .institute-row a {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    letter-spacing: 0.03em;
  }

  .institute-row a:hover {
    color: var(--gold);
    text-decoration: none;
  }
</style>
