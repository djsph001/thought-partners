---
const pathname = Astro.url.pathname;

// Section-aware active states: a nav item can own multiple routes.
const bookRoutes = [
  '/book',
  '/antichrist-prophet',
  '/antichrist-read',
  '/mycelium-of-meaning',
  '/entangled-sovereign',
  '/entangled-sovereign-read',
];
const isActive = (path: string, routes: string[] = []) =>
  pathname === path ||
  (path !== '/' && pathname.startsWith(path)) ||
  routes.some((r) => pathname === r || pathname.startsWith(r + '/'));
---

<header class="site-header">
  <div class="container--wide header-inner">
    <a href="/" class="wordmark">Dale Joseph</a>
    <nav class="nav">
      <a href="/books" class:list={['nav-link', { active: isActive('/books', bookRoutes) }]}>Books</a>
      <a href="/blog" class:list={['nav-link', { active: isActive('/blog') }]}>Essays</a>
      <a href="/emergence" class:list={['nav-link', { active: isActive('/emergence') }]}>Institute</a>
      <a href="/about" class:list={['nav-link', { active: isActive('/about') }]}>About</a>
      <a href="/contact" class:list={['nav-link', { active: isActive('/contact') }]}>Contact</a>
    </nav>
  </div>
  <slot name="contextual" />
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    padding: 1.25rem 0;
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .wordmark {
    font-family: Georgia, serif;
    font-size: 1.05rem;
    color: var(--text);
    letter-spacing: 0.01em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark:hover {
    color: var(--gold);
    text-decoration: none;
  }

  .nav {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .nav-link {
    font-family: Georgia, serif;
    font-size: 0.9rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--gold);
    text-decoration: none;
  }

  @media (max-width: 600px) {
    .nav {
      gap: 1.25rem;
    }

    .nav-link {
      font-size: 0.85rem;
    }

    .wordmark {
      font-size: 0.95rem;
    }
  }
</style>
