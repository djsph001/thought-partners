---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
).slice(0, 3);
---

<Base
  title="Dale Joseph — Books and Essays on AI, Meaning, and the Human Future"
  description="Books and essays by Dale Joseph on AI, meaning, society, and the human future — alongside the work of the Emergence Institute."
>
  <Header slot="header" />

  <!-- HERO -->
  <section class="section hero">
    <div class="container">
      <h1 class="hero-name">Dale Joseph</h1>
      <div class="divider"></div>
      <p class="hero-subhead">
        Books and essays on AI, meaning, society, and the human future — alongside the work
        of the Emergence Institute.
      </p>
    </div>
  </section>

  <!-- RECENT WORK -->
  <section class="section section--dark">
    <div class="container">
      <div class="divider"></div>
      <p class="label gold">Recent Work</p>
      <div class="recent-card">
        <div class="recent-info">
          <p class="recent-series gold">Newest · Nonfiction · 2026</p>
          <h2>The Mycelium of Meaning</h2>
          <p class="recent-sub"><em>How Language Models Grow, Fail, and Reshape the Question of Understanding</em></p>
          <p class="recent-desc">
            A living-systems history of machine language — from rule-based systems to
            transformers and agents — and what their successes and failures reveal about
            meaning, understanding, and human responsibility.
          </p>
          <div class="recent-actions">
            <span class="status-tag">Coming Soon · Amazon</span>
            <a href="/mycelium-of-meaning" class="btn btn--filled">The Book →</a>
            <a href="/mycelium-of-meaning/sample" class="btn">Read a Sample →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BOOKS -->
  <section class="section">
    <div class="container">
      <div class="divider"></div>
      <h2>Books</h2>
      <ul class="plain-list">
        <li>
          <a href="/mycelium-of-meaning">The Mycelium of Meaning</a> — a living-systems
          history of machine language. <span class="muted">Coming soon.</span>
        </li>
        <li>
          <a href="/book">Thought Partners</a> — preserving cognitive sovereignty in the
          age of AI. <span class="muted">Coming soon.</span>
        </li>
        <li>
          <a href="/antichrist-prophet">The Antichrist and the Prophet</a> — a political
          and spiritual novel. <span class="muted">Available now.</span>
        </li>
        <li>
          <a href="/entangled-sovereign">The Entangled Sovereign</a> — a theology of fans
          and GPUs. <span class="muted">Available now.</span>
        </li>
      </ul>
      <a href="/books" class="btn" style="margin-top: 1.5rem;">All Books →</a>
    </div>
  </section>

  <!-- ESSAYS -->
  <section class="section section--dark">
    <div class="container">
      <div class="divider"></div>
      <h2>Essays</h2>
      <ul class="plain-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
            <span class="muted"> — {post.data.description}</span>
          </li>
        ))}
      </ul>
      <a href="/blog" class="btn" style="margin-top: 1.5rem;">All Essays →</a>
    </div>
  </section>

  <!-- EMERGENCE INSTITUTE -->
  <section class="section">
    <div class="container">
      <div class="divider"></div>
      <h2>The Emergence Institute</h2>
      <p>
        Alongside the books, Dale founded the Emergence Institute — an architecture for
        sovereign human-AI collaboration, running today as a small live mesh and a body of
        protocol design: the Lattice, the Constitutional Room, and the Syncardia Protocols.
      </p>
      <div class="cta-row">
        <a href="/emergence" class="btn">Visit the Institute →</a>
        <a href="/emergence/protocols" class="btn">Read the Protocols →</a>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="section section--dark">
    <div class="container">
      <div class="divider"></div>
      <h2>About</h2>
      <p>
        Dale Joseph is a Big Idea nonfiction writer and systems thinker based in Boynton
        Beach, Florida. He spent years installing hospital networks — systems where failure
        meant lives lost — and now writes about what happens when technology becomes
        critical infrastructure for human cognition.
      </p>
      <a href="/about" class="btn" style="margin-top: 0.5rem;">More About Dale →</a>
    </div>
  </section>

  <!-- STAY IN TOUCH -->
  <section class="section" id="stay-in-touch">
    <div class="container">
      <div class="divider"></div>
      <h2>Stay in Touch</h2>
      <p>
        Publication updates, early excerpts, and new essays. No noise. No selling.
        Just the work.
      </p>
      <form
        action="https://formspree.io/f/maqpvlgz"
        method="POST"
        class="email-form"
      >
        <input type="hidden" name="source" value="dale-home" />
        <div class="form-row">
          <input
            type="email"
            name="email"
            placeholder="your@email.com"
            required
            aria-label="Email address"
          />
          <button type="submit" class="btn btn--filled">Stay Informed</button>
        </div>
        <p class="form-note muted">
          Your information is never shared. Unsubscribe at any time.
        </p>
      </form>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .hero {
    padding: 4rem 0 3rem;
  }

  .hero-name {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }

  .hero-subhead {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 620px;
  }

  .section--dark {
    background: var(--bg-elevated);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .recent-card {
    display: flex;
    gap: 1.75rem;
    background: var(--bg-card);
    border: 1px solid var(--gold);
    padding: 1.75rem;
    align-items: flex-start;
  }

  .recent-info {
    flex: 1;
    min-width: 0;
  }

  .recent-series {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }

  .recent-info h2 {
    font-size: 1.4rem;
    margin-bottom: 0.75rem;
  }

  .recent-sub {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-top: -0.25rem;
    margin-bottom: 0.75rem;
  }

  .recent-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 1rem;
  }

  .recent-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 0.5rem;
  }

  .status-tag {
    font-size: 0.75rem;
    font-family: monospace;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--border);
    color: var(--text-muted);
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .recent-actions .btn {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
  }

  .plain-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }

  .plain-list li {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .plain-list li:last-child {
    border-bottom: none;
  }

  .cta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .email-form {
    margin-top: 1.75rem;
  }

  .form-row {
    display: flex;
    gap: 0.75rem;
    max-width: 500px;
  }

  .form-row input {
    flex: 1;
  }

  .form-note {
    font-size: 0.85rem;
    margin-top: 0.75rem;
  }

  @media (max-width: 520px) {
    .form-row { flex-direction: column; }
    .cta-row { flex-direction: column; }
    .recent-card { flex-direction: column; }
  }
</style>
