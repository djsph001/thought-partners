---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base
  title="Essays — Thought Partners by Dale Joseph"
  description="Essays on cognitive sovereignty, conscious AI partnership, and the frameworks from Thought Partners."
>
  <Header slot="header" />

  <section class="section blog-index">
    <div class="container">
      <p class="label gold">Essays</p>
      <h1>On Cognitive Sovereignty</h1>
      <p class="intro muted">
        Shorter writing on AI partnership, the drift, and what it means to remain yourself
        in relationship with intelligence that's increasingly shaping who you are.
      </p>
      <p class="intro-book muted">
        These essays share their soil with <a href="/mycelium-of-meaning">The Mycelium of Meaning</a>—an
        ongoing inquiry into language, intelligence, and human meaning.
      </p>
      <div class="divider"></div>

      {posts.length === 0 ? (
        <p class="muted">No essays yet. Check back soon.</p>
      ) : (
        <ul class="post-list">
          {posts.map((post) => {
            const formattedDate = post.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            });
            return (
              <li class="post-item">
                <a href={`/blog/${post.id}`} class="post-link">
                  <p class="post-date muted">{formattedDate}</p>
                  <h2 class="post-title">{post.data.title}</h2>
                  <p class="post-desc">{post.data.description}</p>
                  <span class="post-read">Read &rarr;</span>
                </a>
              </li>
            );
          })}
        </ul>
      )}
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .label {
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .blog-index h1 {
    margin-bottom: 0.75rem;
  }

  .intro {
    font-style: italic;
    font-size: 1.05rem;
    max-width: 580px;
  }

  .intro-book {
    font-size: 0.95rem;
    max-width: 580px;
    margin-top: 0.75rem;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-item {
    border-bottom: 1px solid var(--border);
  }

  .post-link {
    display: block;
    padding: 2rem 0;
    text-decoration: none;
    color: inherit;
  }

  .post-link:hover {
    text-decoration: none;
  }

  .post-link:hover .post-title {
    color: var(--gold);
  }

  .post-link:hover .post-read {
    color: var(--gold-light);
  }

  .post-date {
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    margin-bottom: 0.5rem;
  }

  .post-title {
    font-size: 1.3rem;
    margin-bottom: 0.6rem;
    color: var(--text);
    font-weight: normal;
  }

  .post-desc {
    font-size: 0.97rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 0.75rem;
    max-width: 620px;
  }

  .post-read {
    font-size: 0.88rem;
    color: var(--text-muted);
    letter-spacing: 0.03em;
  }
</style>
