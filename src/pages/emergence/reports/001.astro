    background: var(--bg-card);
    font-style: italic;
    color: var(--text-muted);
  }

  .rating-line {
    color: var(--gold);
  }

  ul {
    margin: 0 0 1.25rem 1.5rem;
  }

  li {
    margin-bottom: 0.4rem;
  }

  .cta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 3rem;
  }

  @media (max-width: 520px) {
    .cta-row { flex-direction: column; }
  }
</style>
