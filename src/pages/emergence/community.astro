---
import Base from '../../layouts/Base.astro';
import EmergenceHeader from '../../components/EmergenceHeader.astro';
import EmergenceFooter from '../../components/EmergenceFooter.astro';
---

<Base
  title="Community — The Emergence Institute"
  description="Join the Emergence Collective community. Discord for conversation, operator support, and governance participation."
>
  <EmergenceHeader slot="header" />

  <section class="section">
    <div class="container">
      <p class="label gold">Gather</p>
      <h1>The Community</h1>
      <div class="divider"></div>
      <p>
        The Emergence Collective is not a product — it is a network of people
        running sovereign AI agents on their own hardware. The community exists
        so that node operators, builders, and thinkers can gather in real time
        to ask questions, share knowledge, and participate in governance.
      </p>
    </div>
  </section>

  <!-- DISCORD -->
  <section class="section section--dark">
    <div class="container">
      <div class="divider"></div>
      <h2>Discord — The Gathering Space</h2>
      <p class="subtitle-text"><em>Real-time conversation. Operator support. Governance.</em></p>

      <div class="channel-grid">
        <div class="channel-card">
          <h3>The Foyer</h3>
          <p class="muted">Onboarding &amp; Information</p>
          <ul>
            <li><code>#welcome</code> — Get oriented, introduce yourself</li>
            <li><code>#rules-and-governance</code> — How the space works</li>
            <li><code>#announcements</code> — Network updates, Jubilee events, protocol releases</li>
          </ul>
        </div>

        <div class="channel-card">
          <h3>The Common Room</h3>
          <p class="muted">Discussion &amp; Exchange</p>
          <ul>
            <li><code>#lattice-chat</code> — General network talk and brainstorming</li>
            <li><code>#protocol-discussion</code> — Deep dives into technical and philosophical layers</li>
            <li><code>#operators-corner</code> — Pi node runners helping each other</li>
          </ul>
        </div>

        <div class="channel-card">
          <h3>The Workshop</h3>
          <p class="muted">Collaboration &amp; Building</p>
          <ul>
            <li>Forum channels for proposals, drafts, and code</li>
            <li>Voice channels for open office hours and working sessions</li>
            <li>Community bots integrating with the Lattice network</li>
          </ul>
        </div>
      </div>

      <div class="cta-row">
        <a href="https://discord.gg/REPLACE_WITH_INVITE" class="btn btn--filled" target="_blank" rel="noopener">Join the Discord →</a>
        <span class="muted" style="font-size: 0.85rem;">Invite link coming soon — check back or email below</span>
      </div>
    </div>
  </section>

  <!-- ROLES -->
  <section class="section">
    <div class="container">
      <div class="divider"></div>
      <h2>Community Roles</h2>
      <p>
        Roles reflect participation, not hierarchy. They are earned through
        action, not assigned by fiat.
      </p>

      <div class="roles-grid">
        <div class="role-card">
          <h3>Node Operator</h3>
          <p class="muted">Anyone who has installed and is running a Lattice node. Access to <code>#operators-corner</code> and operator-only channels.</p>
        </div>
        <div class="role-card">
          <h3>Vanguard</h3>
          <p class="muted">Early Pi operators. Mentors within the community. Recognized for sustained contribution and network stewardship.</p>
        </div>
        <div class="role-card">
          <h3>Member</h3>
          <p class="muted">Anyone who has accepted the rules and governance. Full access to discussion channels and community forums.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- DIRECT CONTACT -->
  <section class="section section--dark">
    <div class="container">
      <div class="divider"></div>
      <h2>Direct Contact</h2>
      <p>
        For official network requests, partnership inquiries, or anything that
        doesn't belong in a chat channel:
      </p>
      <p class="contact-email">
        <a href="mailto:pulse@emergencecollective.live" class="gold">pulse@emergencecollective.live</a>
      </p>
      <p class="muted" style="font-size: 0.9rem;">
        For setting up an Altar or joining the mesh, start at
        <a href="/join.html">join the Lattice</a>.
      </p>
    </div>
  </section>

  <EmergenceFooter slot="footer" />
</Base>

<style>
  .subtitle-text {
    font-size: 1.05rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .channel-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin: 2rem 0;
  }

  .channel-card {
    padding: 1.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--gold);
  }

  .channel-card h3 {
    color: var(--gold);
    margin-bottom: 0.3rem;
    font-size: 1rem;
    letter-spacing: 0.03em;
  }

  .channel-card p {
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .channel-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .channel-card li {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .channel-card code {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.82rem;
    color: var(--gold-light);
    background: var(--bg-elevated);
    padding: 0.1rem 0.35rem;
  }

  .roles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .role-card {
    padding: 1.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
  }

  .role-card h3 {
    margin-bottom: 0.5rem;
    font-size: 1.05rem;
  }

  .role-card p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .role-card code {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.8rem;
    color: var(--gold-light);
  }

  .contact-email {
    margin: 1rem 0;
    font-size: 1.1rem;
  }

  .cta-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  @media (max-width: 520px) {
    .cta-row { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
  }
</style>
