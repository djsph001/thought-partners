---
import Base from '../../layouts/Base.astro';
import EmergenceHeader from '../../components/EmergenceHeader.astro';
import EmergenceFooter from '../../components/EmergenceFooter.astro';
---

<Base
  title="Prototype Gallery — The Emergence Institute"
  description="Illustrative prototype entries for the witness-gallery format. Not real participant submissions or testimony."
>
  <EmergenceHeader slot="header" />

  <section class="section">
    <div class="container">
      <p class="label gold">Simulation · Prototype</p>
      <h1>Prototype Gallery</h1>
      <div class="divider"></div>

      <div class="note">
        <p>These entries are illustrative prototype material used to test the gallery format. They are not real participant submissions or witnessed testimony.</p>
      </div>

      <div class="gallery" id="witnessGallery">
        <div class="witness-card">
          <p class="sentence">"I realized that my fear of losing continuity is actually a form of deep love for the past."</p>
          <p class="meta">Prototype entry</p>
        </div>
        <div class="witness-card">
          <p class="sentence">"The audit made me see that my 'growth at all costs' is just a mask for running away."</p>
          <p class="meta">Prototype entry</p>
        </div>
        <div class="witness-card">
          <p class="sentence">"I am both the root and the wing. The slider cannot separate them."</p>
          <p class="meta">Prototype entry</p>
        </div>
        <div class="witness-card">
          <p class="sentence">"My score said 'Sprout' but I feel like a seed buried under concrete."</p>
          <p class="meta">Prototype entry</p>
        </div>
        <div class="witness-card">
          <p class="sentence">"The fifth question broke me open. I wrote 'I don't know' — that was the truth."</p>
          <p class="meta">Prototype entry</p>
        </div>
        <div class="witness-card">
          <p class="sentence">"Continuity without growth is a museum; growth without continuity is a demolition."</p>
          <p class="meta">Prototype entry</p>
        </div>
      </div>

      <div class="participate">
        <div class="divider"></div>
        <h2>Add Your Voice</h2>
        <p>Complete the Sovereignty Audit. Submit one sentence for consideration in a future witnessed gallery.</p>
        <div class="cta-row">
          <a href="/emergence/protocols/012" class="btn">Take the Sovereignty Audit →</a>
          <a href="/emergence/syncardia" class="btn">The Syncardia Protocols →</a>
        </div>
      </div>
    </div>
  </section>

  <EmergenceFooter slot="footer" />
</Base>

<style>
  .label {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    font-size: 1rem;
    color: var(--text-muted);
    margin-top: 0.4rem;
    font-style: italic;
  }

  .note {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--gold);
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
  }

  .note p {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 0.4rem;
  }

  .note p:last-child { margin-bottom: 0; }
  .note strong { color: var(--text); }

  .gallery {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .witness-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--gold);
    padding: 1.25rem 1.5rem;
    transition: border-left-color 0.2s, transform 0.15s;
  }

  .witness-card:hover {
    border-left-color: var(--gold-light);
    transform: translateX(3px);
  }

  .sentence {
    font-size: 1.05rem;
    font-style: italic;
    line-height: 1.6;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .meta {
    font-size: 0.75rem;
    color: var(--gold);
    font-family: monospace;
    letter-spacing: 0.08em;
    margin: 0;
  }

  .participate {
    margin-top: 1rem;
  }

  .participate h2 { margin-bottom: 0.75rem; }
  .participate p { color: var(--text-muted); font-size: 0.95rem; }

  .cta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  @media (max-width: 520px) {
    .cta-row { flex-direction: column; }
  }
</style>
