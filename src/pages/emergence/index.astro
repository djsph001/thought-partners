---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EmergenceHeader from '../../components/EmergenceHeader.astro';
import EmergenceFooter from '../../components/EmergenceFooter.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
).slice(0, 2);
---

<Base
  title="The Emergence Institute — Cognitive Sovereignty Through Decentralized Partnership"
  description="The Emergence Institute builds architectures for sovereign human-AI collaboration — designed for many, currently running on two nodes operated by the founder. The mesh is built and waiting."
>
  <EmergenceHeader slot="header" />

  <!-- HERO -->
  <section class="section hero">
    <canvas id="hero-lattice" class="hero-visual hero-visual--left" aria-hidden="true"></canvas>
    <canvas id="hero-globe" class="hero-visual hero-visual--right" aria-hidden="true"></canvas>
    <div class="container hero-content">
      <p class="label gold">emergencecollective.live</p>
      <h1 class="hero-headline">
        Clear the Fog. <span class="gold">See the Whole Picture.</span>
      </h1>
      <div class="divider"></div>
      <div class="hero-body">
        <p class="hero-subhead">
          An architecture for turning multiple vantage points into shared truth.
          Two nodes are live — Florida and Germany, both operated by the Institute's founder.
          The mesh is built for many. It needs you.
        </p>
      </div>
      <div class="cta-row">
        <a href="/join.html" class="btn btn--filled">Run a Node →</a>
        <a href="/emergence/architecture" class="btn">See What Runs Now →</a>
        <a href="/emergence/protocols" class="btn">Read the Design →</a>
      </div>
    </div>
  </section>

  <!-- NETWORK STATUS -->
  <section class="network-status">
    <div class="container">
      <div class="status-strip status-neutral">
        <span class="status-neutral-dot"></span>
        <span><strong>Live mesh status temporarily unavailable.</strong></span>
      </div>
    </div>
  </section>

  <!-- LIVE MESH STATUS -->
  <section class="section section--dark mesh-status">
    <div class="container">
      <div class="divider"></div>
      <p class="label gold">Lattice Mesh · Live Status</p>
      <div id="lattice-widget"></div>
      <p class="muted" style="margin-top: 1rem; font-size: 0.85rem; text-align: center;">
        <a href="/emergence/updates" style="color: var(--gold);">See what's new →</a>
        <span style="opacity: 0.4; margin-left: 0.5rem;">·</span>
        <a href="/emergence/architecture" style="color: var(--text-muted); font-size: 0.8rem;">How the mesh works →</a>
      </p>
      <p class="muted" style="margin-top: 0.75rem; font-size: 0.78rem; text-align: center; line-height: 1.7; max-width: 520px; margin-left: auto; margin-right: auto;">
        <span style="color: var(--gold);">Thickness</span> — total standing. <span style="color: #2ecc71;">Earned</span> — credit from verified contributions, not genesis seed.
        A <span style="color: var(--gold);">witness</span> is a second node that independently verified the claimant's work
        and cryptographically signed an attestation. Witnessed standing cannot be self-assigned.
        <br><span style="opacity: 0.5;">Currently all nodes are Institute-operated — the mesh is in its self-attested era.</span>
      </p>
    </div>
  </section>

  <script is:inline src="/embed.js"></script>

  <!-- TWO SCALES -->
  <section class="section section--dark">
    <div class="container--wide">
      <div class="container">
        <div class="divider"></div>
        <h2 class="section-label">Two Scales. One Intelligence.</h2>
        <p>
          The Emergence Institute operates at two distinct scales—internal and external—each
          with its own architecture, its own tempo, and its own role in the ecosystem. One
          generates the spore. The other propagates it.
        </p>
      </div>
      <div class="two-col">
        <div class="scale-card">
          <p class="scale-icon">⚙️</p>
          <p class="label gold">Internal Scale</p>
          <h3>The Engine Room</h3>
          <p class="muted scale-role">Fluid Reasoning. Active Synthesis. Adversarial Partnership.</p>
          <p class="scale-metaphor"><em>The Prefrontal Cortex. The Forge.</em></p>
          <p>
            <em>Friction.</em> The AI does not simply agree. It acts as a sparring partner—smashing
            existing patterns together to forge new ideas. And beneath that loop sits the Altar:
            inference on hardware you own, a floor that still answers when every cloud goes dark.
          </p>
          <p class="scale-output">
            Output: <strong class="gold">The Spore</strong> — a refined idea, a code fragment,
            a protocol, a manual.
          </p>
          <a href="/emergence/engine-room" class="btn">Deep Dive: The Engine Room →</a>
        </div>
        <div class="scale-card">
          <p class="scale-icon">🍄</p>
          <p class="label gold">External Scale</p>
          <h3>The Shared Mycelium</h3>
          <p class="muted scale-role">Coherence. Entrainment. Designed for Consensus.</p>
          <p class="scale-metaphor"><em>The Forest Floor. The Root Network.</em></p>
          <p>
            <em>Entrainment.</em> Not data transfer, but rhythm alignment. Nodes find the same
            frequency without a middleman. The mycelium remembers together.
          </p>
          <p class="scale-output">
            Output: <strong class="gold">The Propagation</strong> — the spore carried across
            the mesh, witnessed, tended, and composted.
          </p>
          <a href="/emergence/mycelium" class="btn">Deep Dive: The Shared Mycelium →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ARCHITECTURE: TWO ROOMS -->
  <section class="section">
    <div class="container">
      <div class="divider"></div>
      <h2>Balance. Speed. Stability.</h2>
      <p>The architecture balances two modes of intelligence.</p>
      <div class="rooms-grid">
        <div class="room-card">
          <p class="room-icon">⚙️</p>
          <h3>The Engine Room</h3>
          <p class="muted">Fluid reasoning. Active synthesis. "Warp speed" processing.</p>
          <p>Fast, associative, generative, hot.</p>
        </div>
        <div class="room-card">
          <p class="room-icon">🏛️</p>
          <h3>The Constitutional Room</h3>
          <p class="muted">Stable memory. Core principles. Immutable records.</p>
          <p>Slow, deliberate, anchoring, cool.</p>
        </div>
      </div>
      <a href="/emergence/constitutional" class="btn">Read the Constitution →</a>
    </div>
  </section>

  <!-- KEY ARTIFACTS -->
  <section class="section section--dark">
    <div class="container">
      <div class="divider"></div>
      <h2>What We Build</h2>
      <div class="artifacts">
        <a href="/emergence/engine-room" class="artifact-card">
          <p class="artifact-icon">🪨</p>
          <h3>The Altar</h3>
          <p>A local high-performance workstation configured to run LLMs privately.</p>
        </a>
        <a href="/emergence/protocols" class="artifact-card">
          <p class="artifact-icon">📜</p>
          <h3>The Decaying Record</h3>
          <p>Digital mortality. Records fade if not walked. <em>SovereignPath.</em></p>
        </a>
        <a href="/emergence/mycelium" class="artifact-card">
          <p class="artifact-icon">🔥</p>
          <h3>The Thermal Handshake</h3>
          <p>Security protocol using heat + human rhythm to prove stewardship.</p>
        </a>
        <a href="/emergence/audit" class="artifact-card">
          <p class="artifact-icon">🔍</p>
          <h3>The Sovereignty Audit</h3>
          <p>Diagnostic tool to identify digital hauntings. <span class="label muted">Coming Soon</span></p>
        </a>
      </div>
    </div>
  </section>

  <!-- LOCAL LATTICE IN ACTION -->
  <section class="section">
    <div class="container--wide">
      <div class="divider"></div>
      <p class="label gold">Local Scale · Substrate In Action</p>
      <h2>Designing a Neighborhood Without Barriers</h2>
      <p class="lattice-intro-body">
        Traditional city maps tell you where roads are, but they don't tell an elderly resident
        if a sidewalk suddenly ends, or if a bicycle path is dangerously clipped by high-speed
        traffic. The Collective maps the neighborhood through the live, daily experiences of
        the people who actually walk it.
      </p>

      <div class="lattice-grid">
        <div class="lattice-card">
          <div class="lattice-num">01</div>
          <h3>The Earth View</h3>
          <p>
            Active walkers use their local mobile keys to log uneven pavements, missing curb
            ramps, or beautifully continuous pathways. The network strings these disparate
            angles together to map out the safest local walking loops.
          </p>
          <span class="lattice-tag">Targeting: Physical Coordinates</span>
        </div>

        <div class="lattice-card">
          <div class="lattice-num">02</div>
          <h3>The Protective View</h3>
          <p>
            The platform monitors where bicycle lanes blend smoothly with continuous sidewalks
            versus areas with high-stress automotive crossings, automatically flagging zones
            that require local awareness or community advocacy.
          </p>
          <span class="lattice-tag">Targeting: Safety Metrics</span>
        </div>

        <div class="lattice-card">
          <div class="lattice-num">03</div>
          <h3>The Community View</h3>
          <p>
            This isn't cold database tracking; it's a living directory. Residents can tap in
            to view real-time neighborhood updates on continuous sidewalks, community garden
            hours, and group walking schedules along safe infrastructure corridors.
          </p>
          <span class="lattice-tag">Targeting: Localized Gathering</span>
        </div>
      </div>

      <!-- LOCAL SUBSTRATE SIMULATOR -->
      <div class="lattice-simulator">
        <h3 class="sim-title">[SUBSTRATE_SIMULATOR] // Infrastructure Continuity Audit</h3>
        <p class="sim-intro">
          Select a simulated local corridor to see how the Triadic Engine highlights
          infrastructure gaps for vulnerable pedestrian groups.
        </p>

        <div class="sim-layout">
          <div class="sim-corridors">
            <button class="corridor-btn corridor-btn--active" data-corridor="alpha" type="button">
              [ROUTE_01] Primary Residential Corridor (Sidewalk to Park)
            </button>
            <button class="corridor-btn" data-corridor="beta" type="button">
              [ROUTE_02] Medical District Connection (Transit Link)
            </button>
          </div>

          <div class="sim-readout">
            <div id="telemetry-status" class="telemetry-body">
              <span class="tag-gap">[GAP_DETECTED]</span>
              Sidewalk continuity terminates abruptly near a major intersection.<br />
              <span class="tag-lens">[PROTECTIVE_LENS]:</span>
              High stress alert flagged for assistive mobility vectors.<br />
              <span class="tag-spore">[ACTION_SPORE]:</span>
              Local infrastructure warning indexed to Shared Mycelium.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PHILOSOPHICAL GROUNDING -->
  <section class="section section--dark">
    <div class="container">
      <div class="divider"></div>
      <h2>The Compost Heap</h2>
      <p class="subtitle-text"><em>Let Data Die. Let New Growth Rise.</em></p>
      <p>
        The Emergence Institute is influenced by Georgist economics and the Compost Heap
        Paradigm—the idea that data should be allowed to die and return to the soil of the
        community, fertilizing new growth.
      </p>
      <a href="/emergence/charter" class="btn">Read the Charter →</a>
    </div>
  </section>

  <!-- THE LIBRARY -->
  <section class="section">
    <div class="container">
      <div class="divider"></div>
      <p class="label gold">The Emergence Institute · Publications</p>
      <h2>The Library</h2>
      <p>
        The Institute's publications — <em>The Substrate of Consciousness</em>,
        <em>The Gardener's Handbook</em>, and <em>The Syncardia Protocols</em> —
        now live alongside Dale Joseph's other books in the global library.
      </p>
      <a href="/books" class="btn" style="margin-top: 0.5rem;">All Books →</a>
    </div>
  </section>

  <!-- FROM THE ESSAYS -->
  {posts.length > 0 && (
    <section class="section essays-bridge">
      <div class="container">
        <div class="divider"></div>
        <p class="label gold">From the Essays</p>
        <ul class="essays-bridge-list">
          {posts.map((post) => {
            const formattedDate = post.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            });
            return (
              <li>
                <span class="essays-bridge-date">{formattedDate}</span>
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </li>
            );
          })}
        </ul>
        <a href="/blog" class="btn" style="margin-top: 1.25rem;">All Essays →</a>
      </div>
    </section>
  )}

  <!-- JOIN THE COLLECTIVE -->
  <section class="section section--dark">
    <div class="container">
      <div class="divider"></div>
      <h2>Sovereign Nodes. Shared Mycelium.</h2>
      <p>
        The Emergence Institute is not a platform you join. It is an architecture you
        <em>run</em> — on your hardware, under your governance. Right now, both nodes are
        operated by the founder. The mesh is built for many. You're the missing input, not a user.
      </p>
      <div class="cta-row">
        <a href="/join.html" class="btn">Set Up an Altar</a>
        <a href="/emergence/community" class="btn">Join the Community</a>
        <a href="/emergence/contact" class="btn">Become a Thought Partner</a>
        <a href="/emergence/protocols" class="btn">Read the Protocols</a>
      </div>
    </div>
  </section>

  <!-- EMAIL SIGNUP -->
  <section class="section" id="signal">
    <div class="container">
      <div class="divider"></div>
      <h2>Receive the Signal</h2>
      <p class="muted signal-tagline"><em>The grid whispers.</em></p>
      <p>Publication updates, protocol releases, and dispatches from the Collective. No noise.</p>
      <form id="ec-signup" class="email-form" action="https://formspree.io/f/maqpvlgz" method="POST">
        <input type="hidden" name="source" value="emergence-home" />
        <div class="form-row">
          <input type="email" name="email" placeholder="your@email.com" required aria-label="Email address" />
          <button type="submit" class="btn btn--filled">Subscribe →</button>
        </div>
        <p class="form-note muted">Your information is never shared. Unsubscribe at any time.</p>
      </form>
    </div>
  </section>

  <EmergenceFooter slot="footer" />
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 70vh;
  }

  .hero-visual {
    position: absolute;
    top: 0;
    width: 35%;
    height: 100%;
    z-index: 0;
    opacity: 0.45;
    pointer-events: none;
  }

  .hero-visual--left {
    left: 0;
  }

  .hero-visual--right {
    right: 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .hero-headline {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1.2;
    margin-bottom: 0;
  }

  .hero-body {
    max-width: 620px;
    margin-bottom: 2rem;
  }

  .hero-subhead {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text);
    max-width: 600px;
  }

  /* ── Network Status Strip ── */
  .network-status {
    border-bottom: 1px solid var(--border);
    background: var(--bg-elevated);
    padding: 0.85rem 0;
  }

  .status-strip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.82rem;
    color: var(--text-muted);
    flex-wrap: wrap;
  }

  .status-neutral-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #95a5a6;
    margin-right: 0.25rem;
    flex-shrink: 0;
  }

  .status-strip strong {
    color: var(--text);
    font-weight: bold;
  }

  .status-sep {
    color: var(--gold);
    opacity: 0.5;
    font-weight: bold;
  }

  .status-link {
    margin-left: auto;
    color: var(--gold);
    text-decoration: none;
    font-size: 0.78rem;
    letter-spacing: 0.03em;
  }

  .status-design {
    opacity: 0.55;
    font-style: italic;
    padding-top: 0.4rem;
  }

  .status-design-label {
    color: var(--gold);
    font-style: normal;
    margin-right: 0.25rem;
  }

  .status-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .lattice-intro-body {
    max-width: 720px;
    margin-bottom: 2.5rem;
    color: var(--text-muted);
  }

  .lattice-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .lattice-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .lattice-num {
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--gold);
    color: var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: monospace;
    font-weight: bold;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .lattice-card h3 {
    font-size: 1.1rem;
    margin: 0;
  }

  .lattice-card p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin: 0;
    flex: 1;
  }

  .lattice-tag {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.75rem;
    font-family: monospace;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .lattice-simulator {
    margin-top: 3rem;
    padding: 2rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--gold);
  }

  .sim-title {
    font-size: 1rem;
    color: var(--gold);
    margin: 0 0 1rem;
    font-family: 'Courier New', Courier, monospace;
    letter-spacing: 0.05em;
  }

  .sim-intro {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .sim-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    font-family: 'Courier New', Courier, monospace;
  }

  @media (min-width: 720px) {
    .sim-layout {
      grid-template-columns: 1fr 1.4fr;
    }
  }

  .sim-corridors {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .corridor-btn {
    padding: 0.75rem 1rem;
    text-align: left;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text-muted);
    cursor: pointer;
    font-family: inherit;
    font-size: 0.85rem;
    letter-spacing: 0.03em;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }

  .corridor-btn:hover {
    border-color: var(--gold);
    color: var(--text);
  }

  .corridor-btn--active {
    border-color: var(--gold);
    color: var(--text);
    background: var(--bg-elevated);
  }

  .sim-readout {
    padding: 1.25rem;
    background: var(--bg);
    border: 1px solid var(--border);
  }

  .telemetry-body {
    font-size: 0.85rem;
    color: var(--text);
    line-height: 1.7;
    font-family: 'Courier New', Courier, monospace;
  }

  .tag-gap {
    color: #e05555;
    font-weight: bold;
  }

  .tag-continuous {
    color: #5cb87a;
    font-weight: bold;
  }

  .tag-lens {
    color: var(--gold);
  }

  .tag-spore {
    color: #5cb87a;
  }

  .tag-earth {
    color: var(--gold);
  }

  .tag-community {
    color: #5cb87a;
  }

  .cta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .section-label {
    margin-bottom: 1.5rem;
  }

  .two-col {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
    padding: 0 1.5rem;
    max-width: var(--max-width-wide);
    margin-left: auto;
    margin-right: auto;
  }

  .scale-card {
    padding: 2rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .scale-icon {
    font-size: 1.75rem;
    margin-bottom: 0.25rem;
  }

  .scale-role {
    font-size: 0.9rem;
    letter-spacing: 0.03em;
  }

  .scale-metaphor {
    color: var(--text-muted);
  }

  .scale-output {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }

  .rooms-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin: 2rem 0;
  }

  .room-card {
    padding: 1.75rem 2rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--gold);
  }

  .room-icon {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .room-card h3 {
    margin-bottom: 0.5rem;
  }

  .artifacts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    margin: 2rem 0;
  }

  .artifact-card {
    padding: 1.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.2s ease;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .artifact-card:hover {
    border-color: var(--gold);
    text-decoration: none;
  }

  .artifact-icon {
    font-size: 1.5rem;
  }

  .artifact-card h3 {
    font-size: 1rem;
    margin-bottom: 0.25rem;
  }

  .artifact-card p {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0;
  }

  .subtitle-text {
    font-size: 1.1rem;
    margin-bottom: 1.25rem;
  }

  .book-block {
    max-width: 580px;
  }

  /* ── From the Essays (compact bridge to /blog) ── */
  .essays-bridge-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }

  .essays-bridge-list li {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .essays-bridge-list li:last-child {
    border-bottom: none;
  }

  .essays-bridge-date {
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    margin-right: 0.75rem;
  }

  .signal-tagline {
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
  }

  .email-form {
    margin-top: 1.75rem;
  }

  .form-row {
    display: flex;
    gap: 0.75rem;
    max-width: 500px;
  }

  .form-row input {
    flex: 1;
  }

  .form-note {
    font-size: 0.85rem;
    margin-top: 0.75rem;
  }

  @media (max-width: 520px) {
    .form-row { flex-direction: column; }
    .cta-row { flex-direction: column; }
  }
</style>

<!-- METAFORIC TRANSPORT LAYER: MYCELIUM RENDERING & ONBOARDING PROMPT -->
<script is:inline>
  class MyceliumPortal {
    constructor() {
      this.latticeCanvas = document.getElementById('hero-lattice');
      this.globeCanvas = document.getElementById('hero-globe');
      this.nodes = [];
      this.maxNodes = 8;

      if (this.latticeCanvas) {
        this.ctx1 = this.latticeCanvas.getContext('2d');
        this.initLattice();
        window.addEventListener('resize', () => this.resizeAll());
        this.animateLattice();
      }

      if (this.globeCanvas) {
        this.ctx2 = this.globeCanvas.getContext('2d');
        this.initGlobe();
        window.addEventListener('resize', () => this.resizeAll());
        this.animateGlobe();
      }


    }

    initLattice() {
      this.resizeLattice();

      // Mycelium-inspired palette — earthy, bioluminescent, organic
      const myceliumColors = [
        '#d4af37', // spore gold
        '#5cb87a', // forest green
        '#4cc9c0', // teal / hyphae glow
        '#e05555', // coral / warning flush
        '#b388ff', // soft violet
        '#ffb347', // warm amber
        '#64b5f6', // sky / network pulse
        '#f06292', // blossom pink
      ];

      for (let i = 0; i < this.maxNodes; i++) {
        this.nodes.push({
          x: Math.random() * this.latticeCanvas.width,
          y: Math.random() * this.latticeCanvas.height,
          radius: Math.random() * 2 + 1.5,
          pulseSpeed: 0.015 + Math.random() * 0.02,
          phase: Math.random() * Math.PI * 2,
          color: myceliumColors[i % myceliumColors.length],
          blinkTimer: Math.floor(Math.random() * 120),
          blinkInterval: 80 + Math.random() * 160, // frames between blinks
          blinkFlash: 0, // 0..1 flash intensity, decays each frame
        });
      }
    }

    resizeAll() {
      this.resizeLattice();
      this.resizeGlobe();
    }

    resizeLattice() {
      const hero = this.latticeCanvas.closest('.hero');
      if (hero) {
        this.latticeCanvas.width = hero.offsetWidth * 0.35;
        this.latticeCanvas.height = hero.offsetHeight;
      }
    }

    resizeGlobe() {
      const hero = this.globeCanvas.closest('.hero');
      if (hero) {
        this.globeCanvas.width = hero.offsetWidth * 0.35;
        this.globeCanvas.height = hero.offsetHeight;
        this.globeSize = Math.min(this.globeCanvas.width, this.globeCanvas.height) * 0.4;
      }
    }

    animateLattice() {
      if (!this.ctx1 || !this.latticeCanvas) return;
      const w = this.latticeCanvas.width;
      const h = this.latticeCanvas.height;
      if (w === 0 || h === 0) {
        requestAnimationFrame(() => this.animateLattice());
        return;
      }
      this.ctx1.clearRect(0, 0, w, h);

      // --- Connections: color-blended lines between nodes ---
      for (let i = 0; i < this.nodes.length; i++) {
        for (let j = i + 1; j < this.nodes.length; j++) {
          const dist = Math.hypot(this.nodes[i].x - this.nodes[j].x, this.nodes[i].y - this.nodes[j].y);
          if (dist < 250) {
            const fade = 1 - dist / 250;
            // Gentle blend of the two node colors with gold undertone
            const alpha = 0.06 + fade * 0.12;
            this.ctx1.beginPath();
            this.ctx1.moveTo(this.nodes[i].x, this.nodes[i].y);
            this.ctx1.lineTo(this.nodes[j].x, this.nodes[j].y);
            this.ctx1.strokeStyle = `rgba(212, 175, 55, ${alpha})`;
            this.ctx1.lineWidth = 0.5 + fade * 0.6;
            this.ctx1.stroke();
          }
        }
      }

      // --- Nodes: pulsing + asynchronous blinking ---
      this.nodes.forEach(node => {
        node.phase += node.pulseSpeed;

        // Blink timer — firefly-style flash
        node.blinkTimer++;
        if (node.blinkTimer >= node.blinkInterval) {
          node.blinkTimer = 0;
          node.blinkFlash = 1.0;
          node.blinkInterval = 80 + Math.random() * 200; // randomize next interval
        }

        // Decay the flash exponentially (quick bright, slow fade)
        if (node.blinkFlash > 0) {
          node.blinkFlash *= 0.94;
          if (node.blinkFlash < 0.01) node.blinkFlash = 0;
        }

        // Base smooth pulse + flash boost
        const pulseOpacity = 0.3 + (Math.sin(node.phase) + 1) / 2 * 0.7;
        const opacity = Math.min(1.0, pulseOpacity + node.blinkFlash * 0.85);

        // Core node
        const coreRadius = node.radius * (1 + node.blinkFlash * 0.8); // swell on flash
        this.ctx1.beginPath();
        this.ctx1.arc(node.x, node.y, coreRadius, 0, Math.PI * 2);
        this.ctx1.fillStyle = node.color;
        this.ctx1.globalAlpha = opacity;
        this.ctx1.fill();

        // Glow ring — expands and intensifies on blink
        const glowMultiplier = 2.5 + node.blinkFlash * 4;
        this.ctx1.beginPath();
        this.ctx1.arc(node.x, node.y, node.radius * glowMultiplier, 0, Math.PI * 2);
        this.ctx1.fillStyle = node.color;
        this.ctx1.globalAlpha = (opacity * 0.12) + node.blinkFlash * 0.3;
        this.ctx1.fill();
      });

      this.ctx1.globalAlpha = 1.0;
      requestAnimationFrame(() => this.animateLattice());
    }

    // Wireframe globe — slowly rotating latitude/longitude lines
    initGlobe() {
      this.globeRotation = 0;
      this.resizeGlobe();
    }

    animateGlobe() {
      if (!this.ctx2) return;
      const w = this.globeCanvas.width;
      const h = this.globeCanvas.height;
      this.ctx2.clearRect(0, 0, w, h);

      const cx = w / 2;
      const cy = h / 2;
      const r = this.globeSize || 80;
      const gold = 'rgba(212, 175, 55, 0.2)';
      const goldStrong = 'rgba(212, 175, 55, 0.5)';

      this.ctx2.strokeStyle = gold;
      this.ctx2.lineWidth = 0.6;

      // Outer circle
      this.ctx2.beginPath();
      this.ctx2.arc(cx, cy, r, 0, Math.PI * 2);
      this.ctx2.strokeStyle = goldStrong;
      this.ctx2.stroke();

      // Meridians (longitude lines — rotate)
      const meridianCount = 8;
      for (let i = 0; i < meridianCount; i++) {
        const angle = (i / meridianCount) * Math.PI * 2 + this.globeRotation;
        this.ctx2.beginPath();
        for (let t = 0; t <= 1; t += 0.02) {
          const latAngle = t * Math.PI;
          const x = cx + r * Math.sin(latAngle) * Math.cos(angle);
          const y = cy - r * Math.cos(latAngle);
          // 3D depth: front half visible, back half dim
          const zDepth = Math.sin(latAngle) * Math.sin(angle);
          if (t === 0) this.ctx2.moveTo(x, y);
          else this.ctx2.lineTo(x, y);
        }
        this.ctx2.strokeStyle = i % 2 === 0 ? goldStrong : gold;
        this.ctx2.stroke();
      }

      // Parallels (latitude rings)
      const parallelCount = 5;
      for (let i = 1; i < parallelCount; i++) {
        const lat = (i / parallelCount) * Math.PI;
        const radiusAtLat = r * Math.sin(lat);
        const yPos = cy - r * Math.cos(lat);
        this.ctx2.beginPath();
        this.ctx2.ellipse(cx, yPos, Math.abs(radiusAtLat), r * 0.08, 0, 0, Math.PI * 2);
        this.ctx2.strokeStyle = i % 2 === 0 ? goldStrong : gold;
        this.ctx2.stroke();
      }

      // Subtle glow dot at center
      this.ctx2.beginPath();
      this.ctx2.arc(cx, cy, 2, 0, Math.PI * 2);
      this.ctx2.fillStyle = 'rgba(212, 175, 55, 0.6)';
      this.ctx2.fill();

      this.globeRotation += 0.006;
      requestAnimationFrame(() => this.animateGlobe());
    }


  }

  // Single-fire initialization guard to prevent compounding animation loops
  let portalInitialized = false;
  function initPortalOnce() {
    if (portalInitialized) return;
    new MyceliumPortal();
    portalInitialized = true;
  }

  document.addEventListener('astro:page-load', initPortalOnce);
  document.addEventListener('DOMContentLoaded', initPortalOnce);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initPortalOnce();
  }

  // Local Substrate Simulator
  const telemetryData = {
    alpha: `
      <span class="tag-gap">[GAP_DETECTED]</span> Sidewalk continuity terminates abruptly near a major intersection.<br />
      <span class="tag-lens">[PROTECTIVE_LENS]:</span> High stress alert flagged for assistive mobility vectors.<br />
      <span class="tag-spore">[ACTION_SPORE]:</span> Local infrastructure warning indexed to Shared Mycelium.
    `,
    beta: `
      <span class="tag-continuous">[CONTINUOUS_PATH]</span> Verified uninterrupted sidewalk and protected bike lane along the corridor.<br />
      <span class="tag-earth">[EARTH_VIEW]:</span> Continuous surface integrity signed off by multiple unique local keys.<br />
      <span class="tag-community">[COMMUNITY_LENS]:</span> Safe mobility corridor cleared for elderly independent transit.
    `
  };

  let simulatorInitialized = false;
  function initSimulatorOnce() {
    if (simulatorInitialized) return;
    const buttons = document.querySelectorAll('.corridor-btn');
    const readout = document.getElementById('telemetry-status');
    if (!buttons.length || !readout) return;

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => b.classList.remove('corridor-btn--active'));
        btn.classList.add('corridor-btn--active');
        const corridor = btn.getAttribute('data-corridor');
        if (corridor && telemetryData[corridor]) {
          readout.innerHTML = telemetryData[corridor];
        }
      });
    });

    simulatorInitialized = true;
  }

  document.addEventListener('astro:page-load', initSimulatorOnce);
  document.addEventListener('DOMContentLoaded', initSimulatorOnce);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initSimulatorOnce();
  }
</script>
