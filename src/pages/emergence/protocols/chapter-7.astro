  .decomp-card--exo .decomp-label  { color: var(--gold); }

  .decomp-card p {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0 0 0.4rem;
    line-height: 1.6;
  }

  .decomp-rule {
    font-size: 0.8rem !important;
    font-style: italic;
    padding-top: 0.4rem;
    border-top: 1px solid var(--border);
    margin-top: 0.4rem !important;
  }

  .method-list {
    list-style: disc;
    padding-left: 1.5rem;
    margin: 1rem 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .method-list li {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .closing-quote {
    background: var(--bg-card);
    border-left: 3px solid var(--gold);
    padding: 1.25rem 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: var(--gold-light, var(--gold));
    font-size: 1rem;
    line-height: 1.8;
  }

  .cta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
