    font-family: monospace;
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .toc-list a:hover { color: var(--gold); }

  h2 { margin-top: 0.5rem; margin-bottom: 1rem; }
  h3 { font-size: 1rem; margin: 0 0 0.4rem; color: var(--gold-light, var(--gold)); }
  p  { line-height: 1.8; font-size: 0.97rem; }

  .property-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 1.5rem 0;
  }

  .prop {
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }

  .prop:last-child { border-bottom: none; }

  .prop p {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.65;
  }

  .comparison-table {
    margin: 1.5rem 0;
    border: 1px solid var(--border);
    background: var(--bg-card);
    overflow-x: auto;
  }

  .comp-row {
    display: grid;
    grid-template-columns: 120px 1fr 1fr;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--text-muted);
    align-items: start;
  }

  .comp-row:last-child { border-bottom: none; }

  .comp-row--header {
    background: #111;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    font-weight: bold;
  }

  .comp-row strong { color: var(--text); }

  .problem-note {
    background: #1a1000;
    border: 1px solid #4a3000;
    border-left: 3px solid var(--gold);
    padding: 1.5rem;
    margin: 2rem 0;
  }

  .problem-note .label { margin-bottom: 0.75rem; }
  .problem-note p:last-child { margin: 0; font-size: 0.9rem; color: var(--text-muted); line-height: 1.7; }

  .decomp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  .decomp-card {
    padding: 1.25rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
  }

  .decomp-card--endo { border-left: 3px solid #5a9a5a; }
  .decomp-card--exo  { border-left: 3px solid var(--gold); }

  .decomp-label {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: bold;
    display: block;
    margin-bottom: 0.5rem;
    color: var(--text-muted);
  }

