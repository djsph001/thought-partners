<style>
  .label {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    font-size: 1rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
    font-style: italic;
  }

  .pathway-tags {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.2rem 0.65rem;
    border-radius: 20px;
    border: 1px solid;
  }

  .tag-sprout { border-color: #5cb87a; color: #5cb87a; }
  .tag-altar { border-color: #4a9c5d; color: #4a9c5d; }

  .stitch-block {
    background: var(--bg-card);
    border-left: 3px solid var(--gold);
    padding: 1.25rem 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: var(--text-muted);
  }

  .stitch-block strong { color: var(--text); }

  .code-block {
    background: #111;
    border: 1px solid var(--border);
    padding: 1rem 1.25rem;
    font-family: 'SF Mono', 'Fira Code', 'Courier New', monospace;
    font-size: 0.8rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    color: #d4d4d4;
    white-space: pre;
    line-height: 1.5;
  }

  .routing-table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }

  .routing-table th, .routing-table td {
    border: 1px solid var(--border);
    padding: 0.75rem 1rem;
    vertical-align: top;
    text-align: left;
  }

  .routing-table th {
    background: var(--bg-card);
    color: var(--text-muted);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .routing-table td:nth-child(2) { color: var(--gold-light); }
  .routing-table td:nth-child(3) { color: var(--text-muted); font-size: 0.85rem; }

  .rule-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 1.5rem;
  }

  .rule-list li {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.95rem;
  }

  .rule-list li:last-child { border-bottom: none; }

  .cta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 520px) {
    .cta-row { flex-direction: column; }
    .routing-table { font-size: 0.8rem; }
    .routing-table th, .routing-table td { padding: 0.5rem; }
  }
</style>
