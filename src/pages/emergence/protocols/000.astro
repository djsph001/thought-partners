    background: #111;
    border: 1px solid var(--border);
    padding: 1rem 1.25rem;
    font-family: 'SF Mono', 'Fira Code', 'Courier New', monospace;
    font-size: 0.82rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    color: #d4d4d4;
    white-space: pre;
    line-height: 1.5;
  }

