    background: #111;
    border: 1px solid var(--border);
    border-left: 3px solid var(--gold);
    padding: 1rem 1.25rem;
    font-family: monospace;
    font-size: 0.85rem;
    margin: 1.5rem 0;
    color: var(--text-muted);
    line-height: 1.75;
  }

  .cta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 520px) {
    .cta-row { flex-direction: column; }
  }
