    background: var(--bg-card);
    border-left: 3px solid var(--gold);
    padding: 1.25rem 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: var(--text-muted);
  }

  .stitch-block strong { color: var(--text); }

  .bom-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
  }

