---
import Base from '../../layouts/Base.astro';
import EmergenceHeader from '../../components/EmergenceHeader.astro';
import EmergenceFooter from '../../components/EmergenceFooter.astro';
---

<Base
  title="Trilateral Receipt Protocol — Governance Spec | The Emergence Institute"
  description="Full cryptographic specification of the Trilateral Receipt protocol: CBOR structure, Ed25519 multi-signature scheme, round lifecycle state machine, role rotation, and Witness escalation for the Tripartite Council."
>
  <EmergenceHeader slot="header" />

  <!-- HERO -->
  <section class="section">
    <div class="container">
      <p class="label gold">Protocol Specification</p>
      <h1>Trilateral Receipt Protocol</h1>
      <p class="sub"><em>Cryptographic consensus across three branches. No signature, no execution.</em></p>
      <div class="divider"></div>
      <p class="intro">
        The Trilateral Receipt is the atomic unit of governance in the Emergence
        Collective. It is a cryptographically signed record — produced at the
        conclusion of every adversarial round — that carries independent signatures
        from the Civic Assembly (Branch I), the Algorithmic Framework (Branch II),
        and the Protocol Mesh (Branch III). A state change is only valid when it is
        accompanied by a complete trilateral receipt. No signature? No execution.
        This is not a voting system. It is a cryptographic checkpoint.
      </p>
    </div>
  </section>

  <!-- RECEIPT STRUCTURE -->
  <section class="section section--dark">
    <div class="container">
      <div class="divider"></div>
      <p class="label gold">Data Structure</p>
      <h2>The Receipt Format</h2>
      <p class="muted layer-intro">
        Every trilateral receipt is a CBOR-encoded document (RFC 8949). CBOR was
        chosen for deterministic serialization, compact wire representation, and
        self-describing schema — the same codec used by the Lattice transport layer.
      </p>

      <div class="code-block" style="padding: 1.75rem;">
        <span class="code-cmd">TrilateralReceipt</span> &#123;<br/>
        &nbsp;&nbsp;<span class="code-keyword">u64</span> <span class="code-field">receipt_id</span>;         <span class="code-comment">// monotonically increasing, network-wide</span><br/>
        &nbsp;&nbsp;<span class="code-keyword">u64</span> <span class="code-field">round_number</span>;        <span class="code-comment">// the adversarial round this receipt concludes</span><br/>
        &nbsp;&nbsp;<span class="code-keyword">u64</span> <span class="code-field">epoch</span>;               <span class="code-comment">// Lattice epoch at time of proposal</span><br/>
        &nbsp;&nbsp;<span class="code-type">Hash</span> <span class="code-field">parent_receipt</span>;      <span class="code-comment">// Blake3 hash of the preceding receipt (chain)</span><br/>
        &nbsp;&nbsp;<span class="code-type">Hash</span> <span class="code-field">proposal_hash</span>;       <span class="code-comment">// Blake3 hash of the proposal payload</span><br/>
        &nbsp;&nbsp;<span class="code-type">Hash</span> <span class="code-field">opposition_hash</span>;     <span class="code-comment">// Blake3 hash of the structured opposition</span><br/>
        &nbsp;&nbsp;<span class="code-type">Hash</span> <span class="code-field">synthesis_hash</span>;      <span class="code-comment">// Blake3 hash of the synthesized resolution</span><br/>
        &nbsp;&nbsp;<span class="code-keyword">u8</span>  <span class="code-field">outcome</span>;              <span class="code-comment">// 0=executed, 1=escalated, 2=withdrawn, 3=expired</span><br/>
        &nbsp;&nbsp;<span class="code-keyword">u64</span> <span class="code-field">proposer_branch</span>;     <span class="code-comment">// branch ID that initiated: 1|2|3</span><br/>
        &nbsp;&nbsp;<span class="code-keyword">u64</span> <span class="code-field">opposer_branch</span>;      <span class="code-comment">// branch ID assigned as Opposer</span><br/>
        &nbsp;&nbsp;<span class="code-keyword">u64</span> <span class="code-field">synthesizer_branch</span>;  <span class="code-comment">// branch ID assigned as Synthesizer</span><br/>
        &nbsp;&nbsp;<span class="code-type">Timestamp</span> <span class="code-field">proposed_at</span>;     <span class="code-comment">// Unix nanoseconds, monotonic clock</span><br/>
        &nbsp;&nbsp;<span class="code-type">Timestamp</span> <span class="code-field">synthesized_at</span>;   <span class="code-comment">// when synthesis completed or round expired</span><br/>
        &nbsp;&nbsp;<span class="code-keyword">u16</span> <span class="code-field">timeout_seconds</span>;     <span class="code-comment">// round timeout, determined by proposal priority</span><br/>
        &nbsp;&nbsp;<span class="code-keyword">[u8; 3]</span> <span class="code-field">signature_count</span>;   <span class="code-comment">// signatures present: [branch1, branch2, branch3] flags</span><br/>
        &nbsp;&nbsp;<span class="code-type">Signature</span> <span class="code-field">sig_branch_i</span>;    <span class="code-comment">// Ed25519 signature from Branch I (Civic Assembly)</span><br/>
        &nbsp;&nbsp;<span class="code-type">Signature</span> <span class="code-field">sig_branch_ii</span>;   <span class="code-comment">// Ed25519 signature from Branch II (Algorithmic)</span><br/>
        &nbsp;&nbsp;<span class="code-type">Signature</span> <span class="code-field">sig_branch_iii</span>;  <span class="code-comment">// Ed25519 signature from Branch III (Protocol Mesh)</span><br/>
        &nbsp;&nbsp;<span class="code-keyword">[u8; 32]</span> <span class="code-field">receipt_hash</span>;     <span class="code-comment">// Blake3 of all fields above (self-referential integrity)</span><br/>
        &#125;
      </div>

      <p class="muted" style="margin-top: 1.5rem;">
        The <code>receipt_hash</code> is computed as Blake3 over the full CBOR encoding
        of all preceding fields, with the three signature slots set to zero-filled
        buffers. After all three signatures are populated, the receipt hash is
        recomputed and becomes the canonical identifier. Any node can verify integrity
        by recomputing the hash and checking it matches.
      </p>
    </div>
  </section>

  <!-- SIGNATURE SCHEME -->
  <section class="section">
    <div class="container">
      <div class="divider"></div>
      <p class="label gold">Cryptographic Signatures</p>
      <h2>Signature Scheme &amp; Verification</h2>

      <div class="spec-grid">
        <div class="spec-card">
          <h3>Algorithm</h3>
          <p>
            All signatures use <strong>Ed25519</strong> (EdDSA over Curve25519, RFC
            8032). This is the same primitive used for node identity in the Lattice
            transport layer, ensuring cryptographic consistency across the stack.
            Ed25519 provides 128-bit security, deterministic signatures (no RNG
            dependency), and compact 64-byte signatures.
          </p>
        </div>

        <div class="spec-card">
          <h3>Key Material</h3>
          <p>
            Each branch maintains its own Ed25519 keypair. Branch I keys are held by
            the Civic Assembly's delegated signers (quorum of N-of-M, where N and M
            are Assembly-configurable). Branch II keys are held inside the Algorithmic
            Framework's secure enclave — the signing key never leaves hardware
            isolation. Branch III keys are generated deterministically by the Protocol
            Mesh from the network's genesis parameters; they are effectively
            immutable.
          </p>
        </div>

        <div class="spec-card">
          <h3>What Gets Signed</h3>
          <p>
            Each branch signs <strong>the same canonical message</strong>: the CBOR
            encoding of the receipt with all three signature slots zero-filled. This
            ensures that all three branches are attesting to the identical set of
            facts — same proposal hash, same opposition hash, same synthesis hash,
            same outcome. There is no ambiguity about what was agreed to.
          </p>
        </div>

        <div class="spec-card">
          <h3>Verification Procedure</h3>
          <p>
            Any node receiving a receipt MUST: (1) Parse the receipt. (2) Extract the
            three signature slots. (3) Serialize the receipt with signature slots
            zeroed. (4) Verify each non-zero signature against its branch's public key
            and the serialized message. (5) Verify that enough signatures are present
            (all three for execution, any two for escalation to Witness). (6) Verify
            that <code>receipt_hash</code> matches Blake3 of the fully-populated CBOR.
            All checks must pass or the receipt is discarded.
          </p>
          <div class="code-block">
            <span class="code-keyword">fn</span> <span class="code-cmd">verify_receipt</span>(receipt: &<span class="code-type">TrilateralReceipt</span>) -> <span class="code-type">Result</span>&lt;<span class="code-keyword">bool</span>&gt; &#123;<br/>
            &nbsp;&nbsp;<span class="code-keyword">let</span> msg = receipt.<span class="code-cmd">serialize_for_signing</span>();  <span class="code-comment">// zeroed sig slots</span><br/>
            &nbsp;&nbsp;<span class="code-keyword">for</span> (branch_id, sig, pubkey) <span class="code-keyword">in</span> receipt.<span class="code-cmd">iter_signatures</span>() &#123;<br/>
            &nbsp;&nbsp;&nbsp;&nbsp;pubkey.<span class="code-cmd">verify</span>(&msg, sig)?;<br/>
            &nbsp;&nbsp;&#125;<br/>
            &nbsp;&nbsp;<span class="code-keyword">let</span> computed = <span class="code-cmd">blake3</span>(&receipt.<span class="code-cmd">to_cbor</span>());<br/>
            &nbsp;&nbsp;<span class="code-cmd">Ok</span>(computed == receipt.receipt_hash)<br/>
            &#125;
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ROUND LIFECYCLE -->
  <section class="section section--dark">
    <div class="container">
      <div class="divider"></div>
      <p class="label gold">State Machine</p>
      <h2>Round Lifecycle</h2>
      <p class="muted layer-intro">
        Every governance round is a finite state machine with mandatory transitions
        and hard timeouts. Rounds that stall are not retried — they escalate or
        expire. The system is designed to degrade gracefully, not to hang.
      </p>

      <div class="lifecycle-diagram">
        <div class="lifecycle-step">
          <div class="lc-badge">0</div>
          <div class="lc-body">
            <h4>Idle</h4>
            <p>A proposal is received from any branch. The mesh validates the proposal's structure and assigns the Opposer and Synthesizer roles via deterministic rotation. The round transitions to <strong>Proposed</strong>. A timeout clock starts.</p>
          </div>
        </div>
        <div class="lifecycle-arrow">↓</div>
        <div class="lifecycle-step">
          <div class="lc-badge">1</div>
          <div class="lc-body">
            <h4>Proposed</h4>
            <p>The proposal is broadcast to all nodes. The assigned Opposer branch has <code>T_oppose</code> (default: 300 seconds, configurable by proposal priority) to produce a structured opposition. If the Opposer fails to respond, the round transitions to <strong>OppositionTimeout</strong>. Otherwise, it transitions to <strong>Opposed</strong>.</p>
          </div>
        </div>
        <div class="lifecycle-arrow">↓</div>
        <div class="lifecycle-step">
          <div class="lc-badge">2</div>
          <div class="lc-body">
            <h4>Opposed</h4>
            <p>The opposition is broadcast. The Synthesizer branch receives both the proposal and the opposition. It has <code>T_synthesize</code> (default: 600 seconds) to produce a coherent resolution. If synthesis succeeds, the round transitions to <strong>Synthesized</strong>. If the Synthesizer declares irreconcilable conflict, the round transitions to <strong>Escalated</strong>. If the Synthesizer times out, the round transitions to <strong>SynthesisTimeout</strong>.</p>
          </div>
        </div>
        <div class="lifecycle-arrow">↓</div>
        <div class="lifecycle-step">
          <div class="lc-badge">3a</div>
          <div class="lc-body">
            <h4>Synthesized</h4>
            <p>The synthesis is broadcast to all three branches. Each branch independently verifies that the synthesis faithfully resolves the proposal-opposition pair. If verified, each branch signs. Once all three signatures are collected, the receipt is finalized, the Lattice executes the state change, and the round transitions to <strong>Executed</strong>.</p>
          </div>
        </div>
        <div class="lifecycle-split">
          <div class="lifecycle-step">
            <div class="lc-badge fail">3b</div>
            <div class="lc-body">
              <h4>Escalated</h4>
              <p>Irreconcilable conflict. The Synthesizer broadcasts a structured deadlock report identifying the specific point of impasse. The round transitions to the Witness Escalation Protocol. The receipt carries outcome=1 (escalated) with whatever signatures have been collected. A new round may be initiated with a revised proposal.</p>
            </div>
          </div>
        </div>
        <div class="lifecycle-arrow">↓</div>
        <div class="lifecycle-step">
          <div class="lc-badge final">4</div>
          <div class="lc-body">
            <h4>Executed / Expired / Withdrawn</h4>
            <p><strong>Executed:</strong> All three signatures collected. State change committed. Receipt permanently recorded. <strong>Expired:</strong> Timeout reached without resolution. Receipt recorded with outcome=3. <strong>Withdrawn:</strong> Proposer retracts before opposition phase completes. Receipt recorded with outcome=2. All terminal states produce a receipt — the Lattice never silently drops a round.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ROLE ROTATION -->
  <section class="section">
    <div class="container">
      <div class="divider"></div>
      <p class="label gold">Fair Assignment</p>
      <h2>Role Rotation</h2>
      <p class="intro">
        Branch roles (Proposer, Opposer, Synthesizer) rotate deterministically each
        round to prevent any single branch from consistently occupying an advantageous
        position. The rotation is computed from the previous receipt hash — making it
        unpredictable in advance but verifiable by any node after the fact.
      </p>

      <div class="spec-grid">
        <div class="spec-card">
          <h3>Deterministic Derivation</h3>
          <p>
            For round <code>N</code>, the role assignment is derived from
            <code>Blake3(parent_receipt_hash || N.to_be_bytes())</code>. The resulting
            hash is interpreted as a permutation of [1,2,3] using Fisher-Yates shuffle
            seeded by the hash bytes. This produces six possible role assignments with
            uniform probability.
          </p>
          <div class="code-block">
            <span class="code-keyword">fn</span> <span class="code-cmd">assign_roles</span>(parent_hash: &[<span class="code-keyword">u8</span>; 32], round: <span class="code-keyword">u64</span>) -> <span class="code-type">RoleAssignment</span> &#123;<br/>
            &nbsp;&nbsp;<span class="code-keyword">let</span> seed = <span class="code-cmd">blake3_hash</span>(parent_hash, &round.<span class="code-cmd">to_be_bytes</span>());<br/>
            &nbsp;&nbsp;<span class="code-type">RoleAssignment</span>::<span class="code-cmd">from_seed</span>(seed)<br/>
            &#125;
          </div>
        </div>

        <div class="spec-card">
          <h3>Rotation Constraints</h3>
          <p>
            Two additional constraints guard against gaming: (1) A branch that
            proposed in round <code>N</code> cannot propose in round <code>N+1</code>
            — the rotation is re-seeded if this occurs. (2) A branch that timed out
            as Opposer or Synthesizer in the previous three rounds is deprioritized
            for those roles for the next two. These constraints are enforced
            post-derivation: the assignment is recomputed with an incremented nonce
            until constraints are satisfied.
          </p>
        </div>

        <div class="spec-card">
          <h3>Genesis Round</h3>
          <p>
            The genesis receipt (receipt_id=0) has no parent. Its role assignment is
            derived from the network genesis parameters — a deterministic seed agreed
            upon at network initialization. This ensures that even the first round's
            role assignment is verifiable and not subject to manipulation by early
            participants.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WITNESS ESCALATION -->
  <section class="section section--dark">
    <div class="container">
      <div class="divider"></div>
      <p class="label gold">Deadlock Resolution</p>
      <h2>Witness Escalation Protocol</h2>
      <p class="muted layer-intro">
        When the adversarial loop reaches genuine irreconcilable conflict —
        synthesis is impossible without overriding one branch's legitimate concern —
        the round escalates to human judgment. This is not a failure mode. It is a
        designed pressure-release valve that acknowledges the limits of algorithmic
        resolution.
      </p>

      <div class="path-steps">
        <div class="path-step">
          <p class="step-label gold">Trigger</p>
          <p>
            The Synthesizer broadcasts a <strong>Deadlock Report</strong>: a
            structured document identifying the specific proposition where the
            proposal and opposition cannot be reconciled. The report must cite the
            exact claims from both sides and explain why synthesis is impossible
            without overriding one. Vague "agree to disagree" reports are rejected;
            the Synthesizer must re-attempt with specificity.
          </p>
        </div>
        <div class="path-step">
          <p class="step-label gold">Witness Selection</p>
          <p>
            A panel of <strong>5 human Witnesses</strong> is drawn from the Civic
            Assembly using sortition — random selection from the pool of registered
            Assembly members who have not participated in the last 3 escalations.
            Members can opt out of the Witness pool; those who remain are weighted
            equally. Selection is deterministic from the deadlock report hash, making
            it verifiable that no cherry-picking occurred.
          </p>
        </div>
        <div class="path-step">
          <p class="step-label gold">Deliberation</p>
          <p>
            Witnesses receive the full proposal, opposition, and deadlock report.
            They have <code>T_witness</code> (default: 86,400 seconds / 24 hours) to
            deliberate and produce a <strong>Witness Ruling</strong>: a structured
            decision that resolves the impasse. The ruling can side with the proposal,
            side with the opposition, or propose a modified resolution. Majority (3 of
            5) is required. The ruling is signed by each Witness and broadcast as a new
            proposal for a fresh adversarial round.
          </p>
        </div>
        <div class="path-step">
          <p class="step-label gold">Re-entry</p>
          <p>
            The Witness Ruling becomes a new proposal in the normal adversarial
            pipeline — it must pass through opposition and synthesis like any other
            proposal. The Witnesses do not bypass the Council; they unstick it. The
            original deadlocked round is recorded with outcome=1 (escalated) and its
            receipt is chained as the parent of the Witness-initiated round, preserving
            full audit trail.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- RECEIPT CHAIN -->
  <section class="section">
    <div class="container">
      <div class="divider"></div>
      <p class="label gold">Auditability</p>
      <h2>The Receipt Chain</h2>
      <p class="intro">
        Every receipt carries a <code>parent_receipt</code> hash, forming an
        unbroken cryptographic chain from the genesis receipt forward. This is not
        a blockchain — there is no proof-of-work, no token, no mining. It is a
        hash chain for auditability only: any observer can walk the chain from any
        point backward to genesis and verify that every decision followed the
        adversarial protocol, that all three branches participated, and that no
        receipt was silently inserted or removed.
      </p>

      <div class="code-block" style="text-align: center; padding: 1.5rem;">
        <span class="code-cmd">[Genesis]</span> ──→
        <span class="code-log">receipt_1</span> ──→
        <span class="code-log">receipt_2</span> ──→
        <span class="code-log">receipt_3</span> ──→
        ... ──→
        <span class="code-cmd">[Current Tip]</span><br/><br/>
        <span class="code-comment">// Each arrow is parent_receipt → receipt_id<br/>
        // Tampering with any receipt breaks all subsequent hashes<br/>
        // The entire governance history is verifiable in O(n) time</span>
      </div>

      <div class="spec-grid" style="margin-top: 2rem;">
        <div class="spec-card">
          <h3>Integrity Guarantee</h3>
          <p>
            Modifying any field in any historical receipt changes its
            <code>receipt_hash</code>, which changes the <code>parent_receipt</code>
            field of the next receipt, which changes <em>its</em> hash, and so on
            through the entire chain. Tampering with the past is detectable by any
            node in a single backward walk. There is no way to rewrite history
            without breaking the chain.
          </p>
        </div>
        <div class="spec-card">
          <h3>Partial Verification</h3>
          <p>
            A lightweight node (Tier 1 Edge) does not need the full receipt history.
            It can verify that receipt <code>N</code> is valid by checking: (1) the
            three signatures, (2) the receipt hash, and (3) a single parent link to
            receipt <code>N-1</code>. Full-chain verification is only needed when
            joining the network or after extended disconnection.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CROSS-LINKS -->
  <section class="section section--dark">
    <div class="container">
      <div class="divider"></div>
      <p class="label gold">Continue Reading</p>
      <div class="cta-row">
        <a href="/emergence/tripartite-council" class="btn">The Tripartite Council →</a>
        <a href="/emergence/ethical-hardware-enclave" class="btn">Ethical Hardware Enclave →</a>
        <a href="/emergence/lattice-spec" class="btn">Lattice Protocol Spec →</a>
        <a href="/emergence/architecture" class="btn">Lattice Architecture →</a>
      </div>
    </div>
  </section>

  <EmergenceFooter slot="footer" />
</Base>

<style>
  .muted { color: var(--text-muted); }
  .sub { font-size: 1.1rem; color: var(--text-muted); margin-bottom: 0.5rem; }
  .intro { font-size: 1.05rem; line-height: 1.75; max-width: 720px; color: var(--text-muted); }
  .layer-intro { font-size: 0.95rem; color: var(--text-muted); line-height: 1.7; margin-bottom: 2rem; max-width: 680px; }

  .code-block {
    background: rgba(0,0,0,0.3);
    border: 1px solid var(--border);
    padding: 1.25rem;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.8rem;
    line-height: 1.8;
    margin-top: 0.75rem;
    overflow-x: auto;
  }

  .code-cmd { color: #c792ea; }
  .code-log { color: #89ddff; }
  .code-keyword { color: #c792ea; font-weight: 600; }
  .code-type { color: #ffcb6b; }
  .code-value { color: #f78c6c; }
  .code-field { color: #82aaff; }
  .code-comment { color: #546e7a; font-style: italic; }

  .spec-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .spec-card {
    border: 1px solid var(--border);
    padding: 1.5rem;
  }

  .spec-card h3 {
    font-size: 1.05rem;
    margin: 0 0 0.75rem;
  }

  .spec-card p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin: 0 0 0.75rem;
  }

  .spec-card p:last-child { margin-bottom: 0; }

  /* Lifecycle */
  .lifecycle-diagram {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    margin-top: 2rem;
  }

  .lifecycle-step {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    border: 1px solid var(--border);
    padding: 1.25rem;
    width: 100%;
    max-width: 680px;
  }

  .lc-badge {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: rgba(212,175,55,0.15);
    border: 1px solid var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--gold);
    flex-shrink: 0;
  }

  .lc-badge.fail {
    background: rgba(239,83,80,0.12);
    border-color: #ef5350;
    color: #ef5350;
  }

  .lc-badge.final {
    background: rgba(76,175,80,0.12);
    border-color: #4caf50;
    color: #4caf50;
  }

  .lc-body h4 {
    font-size: 1rem;
    margin: 0 0 0.4rem;
  }

  .lc-body p {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin: 0;
  }

  .lifecycle-arrow {
    color: var(--gold);
    font-size: 1.2rem;
    padding: 0.3rem 0;
  }

  .lifecycle-split {
    width: 100%;
    max-width: 680px;
    margin: 0.5rem 0;
  }

  .path-steps {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 2rem;
    border: 1px solid var(--border);
  }

  .path-step {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .path-step:last-child { border-bottom: none; }

  .step-label {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }

  .path-step p:last-child {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

