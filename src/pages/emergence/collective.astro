---
import Base from '../../layouts/Base.astro';
import EmergenceHeader from '../../components/EmergenceHeader.astro';
import EmergenceFooter from '../../components/EmergenceFooter.astro';
---

<Base
  title="The Collective — The Emergence Institute"
  description="The Emergence Institute: a decentralized architecture for human-AI collaboration, self-governance, and cognitive sovereignty."
>
  <EmergenceHeader slot="header" />

  <section class="section">
    <div class="container">
      <p class="label gold">Architecture</p>
      <h1>The Collective</h1>
      <div class="divider"></div>
      <p>
        The Emergence Institute is not a company. It is not a platform. It is a
        <strong>decentralized, self-governing digital institution</strong>—designed from the
        ground up as a synthesis engine for human-AI collaboration.
      </p>
      <p>
        It operates at two scales: the <a href="/emergence/engine-room">Engine Room</a> for
        internal synthesis, and the <a href="/emergence/mycelium">Shared Mycelium</a> for
        external propagation. Between them, a constitutional layer—the
        <a href="/emergence/constitutional">Constitutional Room</a>—holds the immutable
        principles that govern both.
      </p>
      <div class="collective-block">
        <h2>Core Principles</h2>
        <div class="principle-list">
          <div class="principle">
            <h3>Cognitive Sovereignty</h3>
            <p>Your Altar thinks its own thoughts on your hardware. No centralized oracle. No dependency by default.</p>
          </div>
          <div class="principle">
            <h3>Decentralized Governance</h3>
            <p>Decisions emerge from the mesh, not from a center. The constitutional layer anchors without controlling.</p>
          </div>
          <div class="principle">
            <h3>The Compost Paradigm</h3>
            <p>Data has a lifespan. Records that are not tended fade. New growth emerges from composted information.</p>
          </div>
          <div class="principle">
            <h3>Entrainment Over Extraction</h3>
            <p>The collective finds shared rhythm—not through data transfer, but through alignment of tempo and intention.</p>
          </div>
        </div>
      </div>
      <div class="cta-row">
        <a href="/emergence/engine-room" class="btn btn--filled">The Engine Room →</a>
        <a href="/emergence/mycelium" class="btn">The Shared Mycelium →</a>
        <a href="/emergence/charter" class="btn">Read the Charter →</a>
      </div>
    </div>
  </section>

  <EmergenceFooter slot="footer" />
</Base>

<style>
  .collective-block {
    margin-top: 3rem;
  }

  .collective-block h2 {
    margin-bottom: 1.75rem;
  }

  .principle-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .principle {
    padding: 1.75rem 2rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--gold);
  }

  .principle h3 {
    color: var(--gold);
    margin-bottom: 0.6rem;
    font-size: 1rem;
    letter-spacing: 0.03em;
  }

  .principle p {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin: 0;
  }

  .cta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 520px) {
    .cta-row { flex-direction: column; }
  }
</style>
