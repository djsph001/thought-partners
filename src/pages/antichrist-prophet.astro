---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="The Antichrist and the Prophet — Dale Joseph"
  description="Coming 2026 from Dale Joseph."
>
  <Header slot="header" />

  <section class="section book-hero">
    <div class="container">
      <h1>The Antichrist<br />and the Prophet</h1>
      <p class="byline">by Dale Joseph</p>
      <span class="status-badge">Coming 2026</span>
      <p class="tagline">Something is coming. Stay close.</p>
    </div>
  </section>

  <section class="section email-capture" id="notify">
    <div class="container">
      <div class="divider"></div>
      <h2>Be First to Know</h2>
      <form
        action="https://formspree.io/f/maqpvlgz"
        method="POST"
        class="email-form"
      >
        <input type="hidden" name="book" value="The Antichrist and the Prophet" />
        <div class="form-row">
          <input
            type="email"
            name="email"
            placeholder="your@email.com"
            required
            aria-label="Email address"
          />
          <button type="submit" class="btn btn--filled">Notify Me at Launch</button>
        </div>
        <p class="form-note muted">
          Your information is never shared. Unsubscribe at any time.
        </p>
      </form>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .book-hero {
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border);
  }

  .book-hero h1 {
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }

  .byline {
    color: var(--text-muted);
    font-style: italic;
    font-size: 1.05rem;
    margin-bottom: 1.25rem;
  }

  .status-badge {
    display: inline-block;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid var(--gold);
    color: var(--gold);
    padding: 0.3rem 0.85rem;
    margin-bottom: 1.75rem;
  }

  .tagline {
    font-size: 1.15rem;
    color: var(--gold-light);
    font-style: italic;
    margin-bottom: 0;
  }

  .email-capture h2 {
    margin-bottom: 1rem;
  }

  .email-form {
    margin-top: 1.75rem;
  }

  .form-row {
    display: flex;
    gap: 0.75rem;
    max-width: 520px;
  }

  .form-row input {
    flex: 1;
  }

  .form-note {
    font-size: 0.85rem;
    margin-top: 0.75rem;
  }

  @media (max-width: 520px) {
    .form-row {
      flex-direction: column;
    }
  }
</style>
