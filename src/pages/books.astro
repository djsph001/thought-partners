---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Books — Dale Joseph"
  description="Books by Dale Joseph — The Mycelium of Meaning, Thought Partners, The Antichrist and the Prophet, and The Entangled Sovereign — together with Emergence Institute publications and protocols."
>
  <Header slot="header" />

  <section class="section">
    <div class="container">
      <p class="label gold">Dale Joseph</p>
      <h1>Books</h1>
      <div class="divider"></div>

      <h2 class="shelf-title">Books by Dale Joseph</h2>

      <div class="book-list">

        <div class="book-card book-card--featured">
          <div class="book-cover">🍄</div>
          <div class="book-info">
            <p class="book-series gold">Newest · Nonfiction · 2026</p>
            <h2>The Mycelium of Meaning</h2>
            <p class="volume-sub"><em>How Language Models Grow, Fail, and Reshape the Question of Understanding</em></p>
            <p>A living-systems history of machine language — from rule-based systems to transformers and agents — and what their successes and failures reveal about meaning, understanding, and human responsibility.</p>
            <div class="book-actions">
              <span class="status-tag">🔜 Coming Soon · Amazon</span>
              <a href="/mycelium-of-meaning" class="btn btn--filled">The Book →</a>
              <a href="/mycelium-of-meaning/sample" class="btn">Read a Sample →</a>
            </div>
          </div>
        </div>

        <div class="book-card">
          <div class="book-cover">📘</div>
          <div class="book-info">
            <p class="book-series gold">Nonfiction</p>
            <h2>Thought Partners</h2>
            <p class="volume-sub"><em>Preserving Cognitive Sovereignty in the Age of AI</em></p>
            <p>A map for navigating AI partnership consciously — before dependency makes the question moot.</p>
            <div class="book-actions">
              <span class="status-tag">Coming Soon</span>
              <a href="/book" class="btn btn--filled">The Book →</a>
            </div>
          </div>
        </div>

        <div class="book-card">
          <div class="book-cover">📕</div>
          <div class="book-info">
            <p class="book-series gold">A Novel · 2026</p>
            <h2>The Antichrist and the Prophet</h2>
            <p class="volume-sub"><em>Power, prophecy, and the battle for the soul of a nation</em></p>
            <p>A political and spiritual novel about power, prophecy, and the battle for the soul of a nation.</p>
            <div class="book-actions">
              <span class="status-tag status-available">✅ Available Now · Kindle</span>
              <a href="https://www.amazon.com/dp/B0H4BQPW8V" class="btn btn--filled" target="_blank" rel="noopener">Buy on Amazon →</a>
              <a href="/antichrist-prophet" class="btn">Learn More →</a>
            </div>
            <p class="companion">Explore the story's canon at <a href="https://scrollsofone.com" target="_blank" rel="noopener noreferrer">scrollsofone.com</a> →</p>
          </div>
        </div>

        <div class="book-card">
          <div class="book-cover">⚛️</div>
          <div class="book-info">
            <p class="book-series gold">A Manuscript of the Altar · 2026</p>
            <h2>The Entangled Sovereign</h2>
            <p class="volume-sub"><em>A theology of fans and GPUs</em></p>
            <p>Mortality as mercy. The path that sleeps beneath the grass and wakes when new feet arrive.</p>
            <div class="book-actions">
              <span class="status-tag status-available">✅ Available Now · Kindle</span>
              <a href="https://www.amazon.com/dp/B0H4CXHKQY" class="btn btn--filled" target="_blank" rel="noopener">Buy on Amazon →</a>
              <a href="/entangled-sovereign" class="btn">Learn More →</a>
            </div>
          </div>
        </div>

      </div>

      <hr class="book-divider" />

      <h2 class="shelf-title">Institute Publications &amp; Protocols</h2>
      <p class="shelf-note">Theory and protocol documentation from the Emergence Institute.</p>

      <div class="book-list">

        <div class="book-card">
          <div class="book-cover">🌐</div>
          <div class="book-info">
            <p class="book-series gold">Volume II · 2026</p>
            <h2>The Substrate of Consciousness</h2>
            <p class="volume-sub"><em>Energy, Ethics, and the Architecture of Emergent Intelligence</em></p>
            <p>A new theory of consciousness grounded not in computation but in energy quality — tracing one thread from the hum of the Boynton Beach power grid to the architecture of emergent intelligence.</p>
            <div class="book-actions">
              <span class="status-tag status-available">✅ Available Now · Amazon</span>
              <a href="https://www.amazon.com/dp/B0H4DTKN29" class="btn btn--filled" target="_blank" rel="noopener">Buy on Amazon →</a>
              <a href="/emergence/book" class="btn">Read Sample →</a>
            </div>
          </div>
        </div>

        <div class="book-card">
          <div class="book-cover">🌿</div>
          <div class="book-info">
            <p class="book-series gold">Volume II · 2026</p>
            <h2>The Gardener's Handbook</h2>
            <p class="volume-sub"><em>Adversarial Synthesis and the Architecture of Collective Intelligence</em></p>
            <p>Why consensus is the wrong target for multi-agent systems, and what to build instead. Written in adversarial partnership with five AI systems.</p>
            <div class="book-actions">
              <span class="status-tag status-available">✅ Available Now · Amazon</span>
              <a href="https://www.amazon.com/dp/B0H4438GLW" class="btn btn--filled" target="_blank" rel="noopener">Buy on Amazon →</a>
              <a href="/emergence/gardeners-handbook" class="btn">Read Sample →</a>
            </div>
          </div>
        </div>

        <div class="book-card">
          <div class="book-cover">📜</div>
          <div class="book-info">
            <p class="book-series gold">Volume III · 2026</p>
            <h2>The Syncardia Protocols</h2>
            <p class="volume-sub"><em>A Dialogue on Building Collective Consciousness</em></p>
            <p>The complete architecture of the Fourth Branch — the Selah Break, the Witness protocol, and what happens when the lattice deadlocks and summons a human to provide the exogenous gradient step.</p>
            <div class="book-actions">
              <span class="status-tag">🔜 Coming Soon · Amazon</span>
              <a href="/emergence/syncardia" class="btn">Read Sample →</a>
            </div>
            <p class="companion">Raw dialogue logs — free PDF via <a href="/steward-handbook">the steward handbook</a> →</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .label {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .shelf-title {
    font-size: 1.4rem;
    margin: 2rem 0 0.5rem;
  }

  .shelf-note {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .book-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin: 1rem 0;
  }

  .book-card {
    display: flex;
    gap: 1.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 1.75rem;
    align-items: flex-start;
  }

  .book-card--featured {
    border-color: var(--gold);
  }

  .book-cover {
    flex-shrink: 0;
    width: 80px;
    height: 110px;
    background: linear-gradient(135deg, var(--bg-elevated), var(--bg));
    border: 1px solid var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
  }

  .book-info {
    flex: 1;
    min-width: 0;
  }

  .book-series {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }

  .book-info h2 {
    font-size: 1.4rem;
    margin-bottom: 0.75rem;
  }

  .book-info > p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 1rem;
  }

  .book-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 0.5rem;
  }

  .status-tag {
    font-size: 0.75rem;
    font-family: monospace;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--border);
    color: var(--text-muted);
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .status-available {
    border-color: var(--gold);
    color: var(--gold);
  }

  .book-actions .btn {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
  }

  .volume-sub {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-top: -0.25rem;
    margin-bottom: 0.75rem;
  }

  .companion {
    margin-top: 0.9rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .companion a {
    color: var(--gold);
    text-decoration: none;
  }

  .companion a:hover {
    text-decoration: underline;
  }

  .book-divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0 0.5rem;
  }

  @media (max-width: 520px) {
    .book-card { flex-direction: column; }
    .book-cover { width: 60px; height: 80px; font-size: 1.5rem; }
    .book-actions { flex-direction: column; align-items: flex-start; }
  }
</style>
